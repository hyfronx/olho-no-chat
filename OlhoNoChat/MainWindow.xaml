<Window x:Class="OlhoNoChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Style="{DynamicResource AppTitleBarStyle}"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Icon="/icons/olho_no_chat.ico"
        Title="" Height="530" Width="360" Closed="Window_Closed" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBarControl">
            <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        </Style>
        <SolidColorBrush x:Key="AppBarBrush" Color="#E85D30" />
        <Style x:Key="QuickCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,1" />
        </Style>
        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#40000000" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- "Fundo" buttons show the result: a dark square, and the checkerboard image editors use for see-through -->
        <Style x:Key="BackgroundSwatch" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <DrawingBrush x:Key="SeeThroughBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#99FFFFFF" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="QuickIconButton" TargetType="Button" BasedOn="{StaticResource QuickButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <!-- On/off button ("Topo"): dark like the others while off, lit (white, orange pin) while on -->
        <Style x:Key="QuickToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#40000000" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#E85D30" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Back" Property="Background" Value="#E6FFFFFF" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Back" Property="Background" Value="#CCFFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Side toolbar in a short window: the buttons scroll, with an arrow at each end that has more buttons -->
        <MenuScrollingVisibilityConverter x:Key="ScrollArrowVisibility" />
        <Style x:Key="QuickScrollArrow" TargetType="RepeatButton">
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="120" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource AppBarBrush}">
                            <Border x:Name="Shade" Background="#33000000">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Background" Value="#59000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shade" Property="Background" Value="#80000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickToolbarScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="False" />
                            <RepeatButton Style="{StaticResource QuickScrollArrow}" VerticalAlignment="Top" Tag="-1"
                                          ToolTip="Mais botões acima" AutomationProperties.Name="Rolar a barra para cima" Click="QuickToolbarArrow_Click">
                                <RepeatButton.Visibility>
                                    <MultiBinding Converter="{StaticResource ScrollArrowVisibility}" ConverterParameter="0">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ComputedVerticalScrollBarVisibility" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="VerticalOffset" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ExtentHeight" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportHeight" />
                                    </MultiBinding>
                                </RepeatButton.Visibility>
                                <ui:FontIcon Glyph="&#xE70E;" FontSize="10" />
                            </RepeatButton>
                            <RepeatButton Style="{StaticResource QuickScrollArrow}" VerticalAlignment="Bottom" Tag="1"
                                          ToolTip="Mais botões abaixo" AutomationProperties.Name="Rolar a barra para baixo" Click="QuickToolbarArrow_Click">
                                <RepeatButton.Visibility>
                                    <MultiBinding Converter="{StaticResource ScrollArrowVisibility}" ConverterParameter="100">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ComputedVerticalScrollBarVisibility" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="VerticalOffset" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ExtentHeight" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportHeight" />
                                    </MultiBinding>
                                </RepeatButton.Visibility>
                                <ui:FontIcon Glyph="&#xE70D;" FontSize="10" />
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Pin while "Topo" is on, crossed-out pin while off -->
        <Style x:Key="AlwaysOnTopIcon" TargetType="ui:FontIcon">
            <Setter Property="Glyph" Value="&#xE77A;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Glyph" Value="&#xE840;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickValue" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Clique para voltar ao padrão" />
        </Style>

        <!-- Channel strip and message box (dark bars inside the orange frame) -->
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F2141414" />
        <SolidColorBrush x:Key="BarLineBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="BarHintBrush" Color="#A6A6A6" />
        <SolidColorBrush x:Key="BarAccentBrush" Color="#FF8A65" />
        <SolidColorBrush x:Key="BarErrorBrush" Color="#FFB9A0" />

        <!-- Flat button: a whole row, an icon or a link inside the dark bars -->
        <Style x:Key="BarFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarLinkButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource BarHintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- One emote of the list: clicking puts its name in the message box (the focus stays there) -->
        <Style x:Key="EmoteButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Rounded corners; the frame line is orange only in scroll mode with the borders hidden (see MainWindow.Frame.cs) -->
        <Border x:Name="WindowFrame" CornerRadius="10" BorderThickness="0" BorderBrush="Transparent">
        <Grid Name="mainWindowGrid">
            <!-- Title bar, channel strip, chat, message box (the resize grip sits in the side toolbar's corner) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <tb:TaskbarIcon
                Name="taskbarControl"
                IconSource="/icons/olho_no_chat.ico"
                ToolTipText="Olho no Chat">

                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu ui:ThemeManager.RequestedTheme="Dark" x:Name="contextMenu">
                        <MenuItem Header="Olho no Chat" IsEnabled="False" />
                        <MenuItem Header="Mostrar/esconder bordas" Click="MenuItem_ToggleBorderVisible" />
                        <MenuItem Header="Modo rolagem (rolar o chat com o mouse)" Click="MenuItem_ToggleInteractable" />
                        <MenuItem x:Name="menuAlwaysOnTop" Header="Sempre no topo" Click="AlwaysOnTop_Click" />
                        <Separator />
                        <MenuItem Header="Configurações" Click="MenuItem_SettingsClick" />
                        <MenuItem Header="Restaurar posição da janela" Click="MenuItem_ResetWindowClick" />
                        <MenuItem Header="Procurar atualizações" Click="MenuItem_CheckForUpdates" />
                        <Separator />
                        <MenuItem Header="Sair" Click="MenuItem_Exit" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <Grid x:Name="AppTitleBar"
                  Grid.ColumnSpan="2"
                  Background="{StaticResource AppBarBrush}"
                  ui:ThemeManager.RequestedTheme="Dark">

                <ui:SimpleStackPanel Orientation="Horizontal">
                    <ui:TitleBarButton
                        x:Name="btnHide"
                        Width="Auto"
                        Click="btnHide_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <!-- Eye with a slash (Segoe MDL2 / Fluent "Hide") -->
                            <ui:FontIcon Glyph="&#xED1A;" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="Ocultar bordas" FontFamily="Segoe UI" Margin="6,0,0,0" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:TitleBarButton>
                </ui:SimpleStackPanel>
            </Grid>

            <Border Grid.Row="2" Name="overlay" Background="black" Opacity="0.01" Panel.ZIndex="1"/>

            <!-- Channel of the chat, under the title bar (see MainWindow.ChannelBar.cs). In its own row like
                 the message box: the chat page (WebView2) is always drawn on top of anything placed over it. -->
            <Border x:Name="ChannelBar" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" Panel.ZIndex="2"
                    Background="{StaticResource BarBackgroundBrush}" BorderBrush="{StaticResource BarLineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Closed: only the channel; a click opens the name box -->
                    <Button x:Name="btnChannelClosed" Style="{StaticResource BarFlatButton}" Height="30" Padding="10,0,10,0"
                            AutomationProperties.Name="Trocar canal"
                            Click="btnChannelClosed_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                            <!-- Name and, right after it, the connection dot (green / pulsing yellow / red) -->
                            <DockPanel Grid.Column="1" Margin="8,0,8,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="ChannelStatusDot" DockPanel.Dock="Right" Width="8" Height="8" Margin="7,1,0,0"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="tbChannelName" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Trocar canal" Margin="5,0,0,1" FontSize="12" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Open: the name box. Always open while there is no channel. -->
                    <Grid x:Name="ChannelEditor" Margin="6,6,6,5" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="tbChannel" MaxLength="300" MinHeight="32" FontSize="14"
                                 ui:ControlHelper.PlaceholderText="Nome do canal da Twitch"
                                 AutomationProperties.Name="Canal da Twitch"
                                 PreviewKeyDown="tbChannel_PreviewKeyDown" TextChanged="tbChannel_TextChanged" />
                        <Button x:Name="btnChannelApply" Grid.Column="1" Margin="6,0,0,0" Height="32" MinWidth="0" Padding="12,0"
                                Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold" Content="Entrar no chat"
                                Click="btnChannelApply_Click" />
                        <Button x:Name="btnChannelCancel" Grid.Column="2" Margin="4,0,0,0" Width="32" Height="32" MinWidth="0" Padding="0"
                                Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center"
                                ToolTip="Fechar sem trocar (Esc)" AutomationProperties.Name="Cancelar" Click="btnChannelCancel_Click">
                            <!-- Chevron up: the strip closes again (the "x" inside the box already means "clear") -->
                            <ui:FontIcon Glyph="&#xE70E;" FontSize="12" Foreground="{StaticResource BarHintBrush}" />
                        </Button>
                        <TextBlock x:Name="tbChannelHint" Grid.Row="1" Margin="2,5,8,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BarHintBrush}" />
                        <Button x:Name="btnLeaveChannel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                                Style="{StaticResource BarLinkButton}" Content="Sair do canal"
                                ToolTip="Para de mostrar o chat desse canal" Click="btnLeaveChannel_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- "Escrever no chat…" (Twitch account connected, see MainWindow.ChatInput.cs). In its own row:
                 the chat page (WebView2) is always drawn on top of anything placed over it. -->
            <Border x:Name="MessageBar" Grid.Row="3" Grid.Column="0" Visibility="Collapsed" Panel.ZIndex="2"
                    Background="{StaticResource BarBackgroundBrush}" BorderBrush="{StaticResource BarLineBrush}" BorderThickness="0,1,0,0" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- The emote button sits inside the right end of the box, like on Twitch -->
                    <TextBox x:Name="tbChatMessage" MaxLength="500" MinHeight="32" FontSize="14" Padding="10,5,40,6"
                             ui:ControlHelper.PlaceholderText="Escrever no chat…"
                             AutomationProperties.Name="Escrever no chat"
                             PreviewKeyDown="tbChatMessage_PreviewKeyDown" TextChanged="tbChatMessage_TextChanged" />
                    <Button x:Name="btnEmotes" Width="32" Height="28" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center" Focusable="False"
                            ToolTip="Emotes e emojis" AutomationProperties.Name="Emotes"
                            PreviewMouseLeftButtonDown="btnEmotes_PreviewMouseLeftButtonDown" Click="btnEmotes_Click">
                        <ui:FontIcon Glyph="&#xE76E;" FontSize="17" Foreground="#D0D0D0" />
                    </Button>
                    <Button x:Name="btnSendChatMessage" Grid.Column="1" Margin="6,0,0,0" MinWidth="0" Width="38" Height="32" Padding="0"
                            Style="{StaticResource AccentButtonStyle}" ToolTip="Enviar (Enter)"
                            AutomationProperties.Name="Enviar mensagem" Click="btnSendChatMessage_Click">
                        <ui:FontIcon Glyph="&#xE724;" FontSize="15" />
                    </Button>
                    <!-- Closes the box (it stays open after sending) -->
                    <Button x:Name="btnCloseChatBox" Grid.Column="2" Margin="4,0,0,0" Width="32" Height="32" MinWidth="0" Padding="0"
                            Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center" Focusable="False"
                            AutomationProperties.Name="Fechar a caixa" Click="btnCloseChatBox_Click">
                        <ui:FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource BarHintBrush}" />
                    </Button>
                    <TextBlock x:Name="tbChatMessageStatus" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"
                               Margin="2,5,2,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BarErrorBrush}" />
                </Grid>
            </Border>

            <!-- Emotes the connected account can use (see MainWindow.Emotes.cs). A popup is its own window,
                 so it can be shown over the chat page. -->
            <Popup x:Name="EmotePopup" PlacementTarget="{Binding ElementName=MessageBar}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Closed="EmotePopup_Closed">
                <Border Width="{Binding ActualWidth, ElementName=MessageBar}" MinWidth="250" Height="300" Margin="0,0,0,4"
                        Background="#FF1C1C1C" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="8"
                        ui:ThemeManager.RequestedTheme="Dark">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="tbEmoteSearch" MinHeight="30" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="Procurar emote"
                                 AutomationProperties.Name="Procurar emote"
                                 TextChanged="tbEmoteSearch_TextChanged" PreviewKeyDown="tbEmoteSearch_PreviewKeyDown" />
                        <Button x:Name="btnEmojiPanel" Grid.Column="1" Margin="6,0,0,0" Height="30" MinWidth="0" Padding="10,0"
                                ToolTip="Abre o painel de emojis do Windows (atalho do Windows: Win + ponto)"
                                AutomationProperties.Name="Emojis" Click="btnEmojiPanel_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xED54;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Emojis" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Access given before the emote list existed: only the global emotes can be shown -->
                        <Border x:Name="EmoteNotice" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                                Background="#2A211D" BorderBrush="#4A3226" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="tbEmoteNotice" FontSize="12" TextWrapping="Wrap" Foreground="#E6D6CF"
                                           Text="Mostrando só os emotes globais. Para ver os seus (do canal e de inscrições), conecte a conta de novo: a Twitch vai pedir uma permissão nova." />
                                <Button x:Name="btnEmoteReconnect" Margin="0,8,0,0" Height="28" MinWidth="0" Padding="12,0"
                                        Style="{StaticResource AccentButtonStyle}" FontSize="12" Content="Conectar de novo"
                                        Click="btnEmoteReconnect_Click" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="EmoteScroll" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="EmoteGroups" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BarAccentBrush}"
                                                       Margin="2,2,0,4" TextTrimming="CharacterEllipsis" />
                                            <ItemsControl ItemsSource="{Binding Emotes}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource EmoteButton}" ToolTip="{Binding Name}"
                                                                AutomationProperties.Name="{Binding Name}" Click="Emote_Click">
                                                            <Image Source="{Binding Image}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="tbEmoteStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="4,16,4,0" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{StaticResource BarHintBrush}" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Popup>

            <!-- Quick settings, only while the borders are shown -->
            <Border x:Name="QuickToolbar" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="46" Background="{StaticResource AppBarBrush}" Panel.ZIndex="2">
                <!-- The gear always shows, right under the other buttons: in a short window the buttons above
                     it scroll (arrows and mouse wheel). The bottom margin keeps the resize grip's corner free. -->
                <Grid VerticalAlignment="Top" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="QuickToolbarScroll" Style="{StaticResource QuickToolbarScroll}">
                        <StackPanel>
                            <TextBlock Text="Texto" Style="{StaticResource QuickCaption}" />
                            <Button Style="{StaticResource QuickButton}" ToolTip="Aumentar o texto" AutomationProperties.Name="Aumentar o texto" Click="MenuItem_ZoomIn"><ui:FontIcon Glyph="&#xE8E8;" FontSize="16" /></Button>
                            <Button Style="{StaticResource QuickButton}" ToolTip="Diminuir o texto" AutomationProperties.Name="Diminuir o texto" Click="MenuItem_ZoomOut"><ui:FontIcon Glyph="&#xE8E7;" FontSize="16" /></Button>
                            <Button x:Name="btnTextSizeValue" Content="100%" Style="{StaticResource QuickValue}" Click="MenuItem_ZoomReset" />

                            <Rectangle Height="1" Fill="#66FFFFFF" Margin="6,4,6,0" />

                            <TextBlock Text="Fundo" Style="{StaticResource QuickCaption}" />
                            <Button Style="{StaticResource QuickButton}" ToolTip="Fundo mais escuro" AutomationProperties.Name="Fundo mais escuro" Click="MenuItem_IncOpacity"><Border Style="{StaticResource BackgroundSwatch}" Background="Black" /></Button>
                            <Button Style="{StaticResource QuickButton}" ToolTip="Fundo mais transparente" AutomationProperties.Name="Fundo mais transparente" Click="MenuItem_DecOpacity"><Border Style="{StaticResource BackgroundSwatch}" Background="{StaticResource SeeThroughBrush}" /></Button>
                            <Button x:Name="btnBackgroundValue" Content="0%" Style="{StaticResource QuickValue}" Click="MenuItem_ResetOpacity" />

                            <Rectangle Height="1" Fill="#66FFFFFF" Margin="6,4,6,3" />

                            <!-- "Sempre no topo" switch (MainWindow.KeepOnTop.cs): lit with a pin while on -->
                            <ToggleButton x:Name="btnQuickTop" Style="{StaticResource QuickToggleButton}" AutomationProperties.Name="Sempre no topo"
                                          Checked="btnQuickTop_Toggled" Unchecked="btnQuickTop_Toggled">
                                <StackPanel>
                                    <ui:FontIcon FontSize="16" Style="{StaticResource AlwaysOnTopIcon}" />
                                    <TextBlock Text="Topo" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="btnQuickScroll" Style="{StaticResource QuickIconButton}" Click="QuickScrollMode_Click">
                                <StackPanel>
                                    <ui:FontIcon Glyph="&#xE962;" FontSize="16" />
                                    <TextBlock Text="Rolar" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <!-- Opens/closes the "Escrever no chat…" box (MainWindow.ChatInput.cs): lit while it is open -->
                            <ToggleButton x:Name="btnQuickWrite" Style="{StaticResource QuickToggleButton}" AutomationProperties.Name="Escrever"
                                          Checked="btnQuickWrite_Toggled" Unchecked="btnQuickWrite_Toggled">
                                <StackPanel>
                                    <ui:FontIcon Glyph="&#xEC42;" FontSize="16" />
                                    <TextBlock Text="Escrever" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1">
                        <Rectangle Height="1" Fill="#66FFFFFF" Margin="6,3,6,3" />

                        <!-- Opens Configurações (left or right click) -->
                        <Button x:Name="btnSettings" Style="{StaticResource QuickIconButton}" ToolTip="Configurações"
                                AutomationProperties.Name="Configurações"
                                MouseRightButtonUp="btnSettings_Click" Click="btnSettings_Click">
                            <StackPanel>
                                <ui:FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="Config." FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shown when WebView2 is missing: covers everything under the title bar, side toolbar included -->
            <Grid x:Name="PlaceholderOverlay" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="3" Background="#80000000" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Background="#FF2D2D30"
                        CornerRadius="8"
                        MaxWidth="400"
                        Padding="25">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Falta um componente"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="PlaceHolderOverlayText"
                                   Text="Para mostrar o chat, o Olho no Chat precisa do WebView2, um componente gratuito da Microsoft. Depois de instalar, o app recarrega sozinho."
                                   Foreground="#DDFFFFFF"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,25"
                                   TextAlignment="Center"/>

                        <Button x:Name="InstallButton"
                                Content="Baixar e instalar"
                                Click="InstallButton_Click"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="Medium"
                                Background="#FF0078D4"
                                Foreground="White"
                                Padding="20,10"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
