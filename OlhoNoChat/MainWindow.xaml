<Window x:Class="OlhoNoChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Style="{DynamicResource AppTitleBarStyle}"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        ResizeMode="CanResize"
        Topmost="True"
        Icon="/icons/olho_no_chat.ico"
        Title="" Height="530" Width="360" MinWidth="334" Closed="Window_Closed" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBarControl">
            <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        </Style>
        <SolidColorBrush x:Key="AppBarBrush" Color="#E85D30" />
        <!-- Channel strip and message box (dark bars inside the orange frame) -->
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F2141414" />
        <SolidColorBrush x:Key="BarLineBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="BarHintBrush" Color="#A6A6A6" />
        <SolidColorBrush x:Key="BarAccentBrush" Color="#FF8A65" />
        <SolidColorBrush x:Key="BarErrorBrush" Color="#FFB9A0" />

        <!-- On/off buttons ("Sempre no topo", "Escrever no chat"): lit (white, orange icon) while on -->
        <Style x:Key="TitleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource TitleIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#2E000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#47000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#E85D30" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Back" Property="Background" Value="#E6FFFFFF" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Back" Property="Background" Value="#CCFFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="#66FFFFFF" />
        </Style>
        <!-- "Fundo": a half-filled circle, drawn (the icon fonts don't share one) -->
        <ControlTemplate x:Key="BackgroundIcon" TargetType="ContentControl">
            <Grid Width="16" Height="16">
                <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
                <Path Data="M8,0 A8,8 0 0 0 8,16 Z" Fill="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate>
        <!-- Pin while "Sempre no topo" is on, crossed-out pin while off -->
        <Style x:Key="AlwaysOnTopIcon" TargetType="ui:FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource TitleIconFont}" />
            <Setter Property="Glyph" Value="&#xE77A;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Glyph" Value="&#xE840;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Slider of the text size and background panels: thin track, filled in orange up to a round thumb -->
        <Style x:Key="QuickSliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Fill="#454545" Stroke="#33FFFFFF" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource BarAccentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="14" />
                                <Setter TargetName="Dot" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="10" />
                                <Setter TargetName="Dot" Property="Height" Value="10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickSlider" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource QuickSliderTrack}" Background="{StaticResource BarAccentBrush}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource QuickSliderTrack}" Background="#4DFFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource QuickSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Panel under a title bar button (a popup is its own window, so it can be shown over the chat page) -->
        <Style x:Key="QuickPanel" TargetType="Border">
            <Setter Property="Width" Value="240" />
            <Setter Property="Padding" Value="14,10,14,8" />
            <Setter Property="Background" Value="#FF1C1C1C" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="TextElement.Foreground" Value="White" />
            <Setter Property="TextElement.FontSize" Value="13" />
            <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        </Style>
        <Style x:Key="QuickPanelHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#A6A6A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Flat button: a whole row, an icon or a link inside the dark bars -->
        <Style x:Key="BarFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarLinkButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource BarHintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- "Voltar ao padrão" in the text size and background panels -->
        <Style x:Key="QuickResetButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0,-4,0" />
            <Setter Property="Foreground" Value="{StaticResource BarHintBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- One emote of the list: clicking puts its name in the message box (the focus stays there) -->
        <Style x:Key="EmoteButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Rounded corners; the frame line is orange only in scroll mode with the borders hidden (see MainWindow.Frame.cs) -->
        <Border x:Name="WindowFrame" CornerRadius="10" BorderThickness="0" BorderBrush="Transparent">
        <Grid Name="mainWindowGrid">
            <!-- Title bar, channel strip, chat, message box -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <tb:TaskbarIcon
                Name="taskbarControl"
                IconSource="/icons/olho_no_chat.ico"
                ToolTipText="Olho no Chat">

                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu ui:ThemeManager.RequestedTheme="Dark" x:Name="contextMenu">
                        <MenuItem Header="Olho no Chat" IsEnabled="False" />
                        <MenuItem Header="Mostrar/esconder bordas" Click="MenuItem_ToggleBorderVisible" />
                        <MenuItem Header="Modo rolagem (rolar o chat com o mouse)" Click="MenuItem_ToggleInteractable" />
                        <MenuItem x:Name="menuAlwaysOnTop" Header="Sempre no topo" Click="AlwaysOnTop_Click" />
                        <Separator />
                        <MenuItem Header="Configurações" Click="MenuItem_SettingsClick" />
                        <MenuItem Header="Restaurar posição da janela" Click="MenuItem_ResetWindowClick" />
                        <MenuItem Header="Procurar atualizações" Click="MenuItem_CheckForUpdates" />
                        <Separator />
                        <MenuItem Header="Sair" Click="MenuItem_Exit" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- Title bar with the quick settings (see MainWindow.QuickActions.cs), only while the borders are shown.
                 Its own close button replaces the window's (see Window_Loaded). -->
            <Grid x:Name="AppTitleBar" Height="32"
                  Background="{StaticResource AppBarBrush}"
                  ui:ThemeManager.RequestedTheme="Dark">
                <Button x:Name="btnClose" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" Margin="0,0,3,0"
                        ToolTip="Fechar o Olho no Chat" AutomationProperties.Name="Fechar" Click="btnClose_Click">
                    <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE8BB;" FontSize="11" />
                </Button>
                <StackPanel Orientation="Horizontal" Margin="3,0,40,0" VerticalAlignment="Center">
                    <!-- Eye with a slash (Segoe Fluent "Hide") -->
                    <Button x:Name="btnHide" Style="{StaticResource TitleIconButton}" AutomationProperties.Name="Ocultar bordas"
                            Click="btnHide_Click">
                        <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xED1A;" />
                    </Button>

                    <Rectangle Style="{StaticResource TitleSeparator}" />

                    <!-- Open a panel with a slider; the mouse wheel over them changes the value right away -->
                    <Button x:Name="btnTextSize" Style="{StaticResource TitleIconButton}" AutomationProperties.Name="Tamanho do texto"
                            PreviewMouseLeftButtonDown="QuickPanelButton_PreviewMouseLeftButtonDown" Click="QuickPanelButton_Click"
                            PreviewMouseWheel="TextSize_PreviewMouseWheel" MouseLeave="QuickPanelButton_MouseLeave">
                        <Button.ToolTip>
                            <ToolTip x:Name="tipTextSize" />
                        </Button.ToolTip>
                        <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE8D2;" />
                    </Button>
                    <Button x:Name="btnBackground" Style="{StaticResource TitleIconButton}" AutomationProperties.Name="Fundo"
                            PreviewMouseLeftButtonDown="QuickPanelButton_PreviewMouseLeftButtonDown" Click="QuickPanelButton_Click"
                            PreviewMouseWheel="Background_PreviewMouseWheel" MouseLeave="QuickPanelButton_MouseLeave">
                        <Button.ToolTip>
                            <ToolTip x:Name="tipBackground" />
                        </Button.ToolTip>
                        <ContentControl Template="{StaticResource BackgroundIcon}" />
                    </Button>

                    <Rectangle Style="{StaticResource TitleSeparator}" />

                    <!-- "Sempre no topo" switch (MainWindow.KeepOnTop.cs): lit with a pin while on -->
                    <ToggleButton x:Name="btnQuickTop" Style="{StaticResource TitleToggleButton}" AutomationProperties.Name="Sempre no topo"
                                  Checked="btnQuickTop_Toggled" Unchecked="btnQuickTop_Toggled">
                        <ui:FontIcon Style="{StaticResource AlwaysOnTopIcon}" />
                    </ToggleButton>
                    <Button x:Name="btnQuickScroll" Style="{StaticResource TitleIconButton}" AutomationProperties.Name="Modo rolagem"
                            Click="QuickScrollMode_Click">
                        <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE962;" />
                    </Button>
                    <Rectangle Style="{StaticResource TitleSeparator}" />

                    <!-- Opens/closes the "Escrever no chat…" box (MainWindow.ChatInput.cs): lit while it is open -->
                    <ToggleButton x:Name="btnQuickWrite" Style="{StaticResource TitleToggleButton}" AutomationProperties.Name="Escrever"
                                  Checked="btnQuickWrite_Toggled" Unchecked="btnQuickWrite_Toggled">
                        <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE8BD;" />
                    </ToggleButton>
                    <!-- Hidden with "Escrever" (chat types without a channel): one line is enough there -->
                    <Rectangle Style="{StaticResource TitleSeparator}" Visibility="{Binding Visibility, ElementName=btnQuickWrite}" />

                    <!-- Opens Configurações (left or right click) -->
                    <Button x:Name="btnSettings" Style="{StaticResource TitleIconButton}" ToolTip="Configurações"
                            AutomationProperties.Name="Configurações"
                            MouseRightButtonUp="btnSettings_Click" Click="btnSettings_Click">
                        <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Popup x:Name="TextSizePanel" PlacementTarget="{Binding ElementName=btnTextSize}" Placement="Bottom" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource QuickPanel}" PreviewKeyDown="QuickPanel_PreviewKeyDown">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="btnTextSizeReset" DockPanel.Dock="Right" Style="{StaticResource QuickResetButton}"
                                    AutomationProperties.Name="Voltar ao padrão" Click="TextSizeReset_Click">
                                <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE7A7;" FontSize="12" />
                            </Button>
                            <TextBlock x:Name="tbTextSizeValue" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource BarAccentBrush}" />
                            <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE8D2;" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="Tamanho do texto" />
                        </DockPanel>
                        <Slider x:Name="sliderTextSize" Style="{StaticResource QuickSlider}" AutomationProperties.Name="Tamanho do texto"
                                Minimum="0.5" Maximum="2.5" TickFrequency="0.05" SmallChange="0.1" LargeChange="0.1"
                                ValueChanged="sliderTextSize_ValueChanged" PreviewMouseWheel="TextSize_PreviewMouseWheel" />
                        <Grid>
                            <TextBlock Text="menor" Style="{StaticResource QuickPanelHint}" HorizontalAlignment="Left" />
                            <TextBlock Text="maior" Style="{StaticResource QuickPanelHint}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="BackgroundPanel" PlacementTarget="{Binding ElementName=btnBackground}" Placement="Bottom" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource QuickPanel}" PreviewKeyDown="QuickPanel_PreviewKeyDown">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="btnBackgroundReset" DockPanel.Dock="Right" Style="{StaticResource QuickResetButton}"
                                    AutomationProperties.Name="Voltar ao padrão" Click="BackgroundReset_Click">
                                <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE7A7;" FontSize="12" />
                            </Button>
                            <TextBlock x:Name="tbBackgroundValue" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource BarAccentBrush}" />
                            <ContentControl Template="{StaticResource BackgroundIcon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Fundo do chat" />
                        </DockPanel>
                        <!-- In percent; saved as 0-255 (OpacityLevel) -->
                        <Slider x:Name="sliderBackground" Style="{StaticResource QuickSlider}" AutomationProperties.Name="Fundo do chat"
                                Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="5"
                                ValueChanged="sliderBackground_ValueChanged" PreviewMouseWheel="Background_PreviewMouseWheel" />
                        <Grid>
                            <TextBlock Text="transparente" Style="{StaticResource QuickPanelHint}" HorizontalAlignment="Left" />
                            <TextBlock Text="escuro" Style="{StaticResource QuickPanelHint}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <Border Grid.Row="2" Name="overlay" Background="black" Opacity="0.01" Panel.ZIndex="1"/>

            <!-- Channel of the chat, under the title bar (see MainWindow.ChannelBar.cs). In its own row like
                 the message box: the chat page (WebView2) is always drawn on top of anything placed over it. -->
            <Border x:Name="ChannelBar" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="2"
                    Background="{StaticResource BarBackgroundBrush}" BorderBrush="{StaticResource BarLineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Closed: only the channel; a click opens the name box -->
                    <Button x:Name="btnChannelClosed" Style="{StaticResource BarFlatButton}" Height="30" Padding="10,0,10,0"
                            AutomationProperties.Name="Trocar canal"
                            Click="btnChannelClosed_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                            <!-- Name and, right after it, the connection dot (green / pulsing yellow / red) -->
                            <DockPanel Grid.Column="1" Margin="8,0,8,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="ChannelStatusDot" DockPanel.Dock="Right" Width="8" Height="8" Margin="7,1,0,0"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="tbChannelName" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE8AB;" FontSize="12" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Trocar canal" Margin="5,0,0,1" FontSize="12" Foreground="{StaticResource BarAccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Open: the name box. Always open while there is no channel. -->
                    <Grid x:Name="ChannelEditor" Margin="6,6,6,5" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="tbChannel" MaxLength="300" MinHeight="32" FontSize="14"
                                 ui:ControlHelper.PlaceholderText="Nome do canal da Twitch"
                                 AutomationProperties.Name="Canal da Twitch"
                                 PreviewKeyDown="tbChannel_PreviewKeyDown" TextChanged="tbChannel_TextChanged" />
                        <Button x:Name="btnChannelApply" Grid.Column="1" Margin="6,0,0,0" Height="32" MinWidth="0" Padding="12,0"
                                Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold" Content="Entrar no chat"
                                Click="btnChannelApply_Click" />
                        <Button x:Name="btnChannelCancel" Grid.Column="2" Margin="4,0,0,0" Width="32" Height="32" MinWidth="0" Padding="0"
                                Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center"
                                ToolTip="Fechar sem trocar (Esc)" AutomationProperties.Name="Cancelar" Click="btnChannelCancel_Click">
                            <!-- Chevron up: the strip closes again (the "x" inside the box already means "clear") -->
                            <ui:FontIcon Glyph="&#xE70E;" FontSize="12" Foreground="{StaticResource BarHintBrush}" />
                        </Button>
                        <TextBlock x:Name="tbChannelHint" Grid.Row="1" Margin="2,5,8,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource BarHintBrush}" />
                        <Button x:Name="btnLeaveChannel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                                Style="{StaticResource BarLinkButton}" Content="Sair do canal"
                                ToolTip="Para de mostrar o chat desse canal" Click="btnLeaveChannel_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- "Escrever no chat…" (Twitch account connected, see MainWindow.ChatInput.cs). In its own row:
                 the chat page (WebView2) is always drawn on top of anything placed over it. -->
            <Border x:Name="MessageBar" Grid.Row="3" Visibility="Collapsed" Panel.ZIndex="2"
                    Background="{StaticResource BarBackgroundBrush}" BorderBrush="{StaticResource BarLineBrush}" BorderThickness="0,1,0,0" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- The emote button sits inside the right end of the box, like on Twitch -->
                    <TextBox x:Name="tbChatMessage" MaxLength="500" MinHeight="32" FontSize="14" Padding="10,5,40,6"
                             ui:ControlHelper.PlaceholderText="Escrever no chat…"
                             AutomationProperties.Name="Escrever no chat"
                             PreviewKeyDown="tbChatMessage_PreviewKeyDown" TextChanged="tbChatMessage_TextChanged" />
                    <Button x:Name="btnEmotes" Width="32" Height="28" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center" Focusable="False"
                            ToolTip="Emotes e emojis" AutomationProperties.Name="Emotes"
                            PreviewMouseLeftButtonDown="btnEmotes_PreviewMouseLeftButtonDown" Click="btnEmotes_Click">
                        <ui:FontIcon Glyph="&#xE76E;" FontSize="17" Foreground="#D0D0D0" />
                    </Button>
                    <Button x:Name="btnSendChatMessage" Grid.Column="1" Margin="6,0,0,0" MinWidth="0" Width="38" Height="32" Padding="0"
                            Style="{StaticResource AccentButtonStyle}" ToolTip="Enviar (Enter)"
                            AutomationProperties.Name="Enviar mensagem" Click="btnSendChatMessage_Click">
                        <ui:FontIcon Glyph="&#xE724;" FontSize="15" />
                    </Button>
                    <!-- Closes the box (it stays open after sending) -->
                    <Button x:Name="btnCloseChatBox" Grid.Column="2" Margin="4,0,0,0" Width="32" Height="32" MinWidth="0" Padding="0"
                            Style="{StaticResource BarFlatButton}" HorizontalContentAlignment="Center" Focusable="False"
                            AutomationProperties.Name="Fechar a caixa" Click="btnCloseChatBox_Click">
                        <ui:FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource BarHintBrush}" />
                    </Button>
                    <TextBlock x:Name="tbChatMessageStatus" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"
                               Margin="2,5,2,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BarErrorBrush}" />
                </Grid>
            </Border>

            <!-- Emotes the connected account can use (see MainWindow.Emotes.cs). A popup is its own window,
                 so it can be shown over the chat page. -->
            <Popup x:Name="EmotePopup" PlacementTarget="{Binding ElementName=MessageBar}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Closed="EmotePopup_Closed">
                <Border Width="{Binding ActualWidth, ElementName=MessageBar}" MinWidth="250" Height="300" Margin="0,0,0,4"
                        Background="#FF1C1C1C" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="8"
                        ui:ThemeManager.RequestedTheme="Dark">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="tbEmoteSearch" MinHeight="30" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="Procurar emote"
                                 AutomationProperties.Name="Procurar emote"
                                 TextChanged="tbEmoteSearch_TextChanged" PreviewKeyDown="tbEmoteSearch_PreviewKeyDown" />
                        <Button x:Name="btnEmojiPanel" Grid.Column="1" Margin="6,0,0,0" Height="30" MinWidth="0" Padding="10,0"
                                ToolTip="Abre o painel de emojis do Windows (atalho do Windows: Win + ponto)"
                                AutomationProperties.Name="Emojis" Click="btnEmojiPanel_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xED54;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Emojis" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Access given before the emote list existed: only the global emotes can be shown -->
                        <Border x:Name="EmoteNotice" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                                Background="#2A211D" BorderBrush="#4A3226" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="tbEmoteNotice" FontSize="12" TextWrapping="Wrap" Foreground="#E6D6CF"
                                           Text="Mostrando só os emotes globais. Para ver os seus (do canal e de inscrições), conecte a conta de novo: a Twitch vai pedir uma permissão nova." />
                                <Button x:Name="btnEmoteReconnect" Margin="0,8,0,0" Height="28" MinWidth="0" Padding="12,0"
                                        Style="{StaticResource AccentButtonStyle}" FontSize="12" Content="Conectar de novo"
                                        Click="btnEmoteReconnect_Click" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="EmoteScroll" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="EmoteGroups" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BarAccentBrush}"
                                                       Margin="2,2,0,4" TextTrimming="CharacterEllipsis" />
                                            <ItemsControl ItemsSource="{Binding Emotes}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource EmoteButton}" ToolTip="{Binding Name}"
                                                                AutomationProperties.Name="{Binding Name}" Click="Emote_Click">
                                                            <Image Source="{Binding Image}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="tbEmoteStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="4,16,4,0" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{StaticResource BarHintBrush}" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Popup>

            <!-- Grip of the bottom-right corner (see MainWindow.ResizeCorner.cs) -->
            <Path x:Name="ResizeCornerGrip" Grid.Row="1" Grid.RowSpan="3" Width="12" Height="12" Margin="0,0,2,2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="2" IsHitTestVisible="False"
                  Fill="#8CFFFFFF" Visibility="Collapsed">
                <Path.Data>
                    <GeometryGroup>
                        <EllipseGeometry Center="9,3" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="9,9" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="3,9" RadiusX="1.1" RadiusY="1.1" />
                        <EllipseGeometry Center="6,6" RadiusX="1.1" RadiusY="1.1" />
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <!-- Shown when WebView2 is missing: covers everything under the title bar -->
            <Grid x:Name="PlaceholderOverlay" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="3" Background="#80000000" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Background="#FF2D2D30"
                        CornerRadius="8"
                        MaxWidth="400"
                        Padding="25">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Falta um componente"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="PlaceHolderOverlayText"
                                   Text="Para mostrar o chat, o Olho no Chat precisa do WebView2, um componente gratuito da Microsoft. Depois de instalar, o app recarrega sozinho."
                                   Foreground="#DDFFFFFF"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,25"
                                   TextAlignment="Center"/>

                        <Button x:Name="InstallButton"
                                Content="Baixar e instalar"
                                Click="InstallButton_Click"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="Medium"
                                Background="#FF0078D4"
                                Foreground="White"
                                Padding="20,10"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
