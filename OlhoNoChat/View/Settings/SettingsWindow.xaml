<Window x:Class="OlhoNoChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Style="{DynamicResource SettingsTitleBarStyle}"
        Title="Configurações"
        Icon="/icons/olho_no_chat.ico"
        WindowStyle="ToolWindow"
        Background="{StaticResource SettingsAccentBrush}"
        Height="720" Width="800" MinHeight="480" MinWidth="680"
        Topmost="True" WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        FocusManager.FocusedElement="{Binding ElementName=lvSettings}">
    <Window.Resources>
        <!-- Rounder controls than the ModernWpf default, only in this window -->
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsAccentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar (the close button is drawn on top of it by ModernWpf) -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <ui:FontIcon Glyph="&#xE713;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
            <TextBlock Text="Configurações" FontSize="15" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center" Margin="12,0,0,1" />
        </StackPanel>

        <!-- Navigation -->
        <ListView Name="lvSettings" Grid.Row="1"
                  Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                  ItemContainerStyle="{StaticResource SettingsNavItem}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  SelectionChanged="ListView_SelectionChanged">
            <ListViewItem Tag="chat" AutomationProperties.Name="Chat">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE8BD;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Chat" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="appearance" AutomationProperties.Name="Aparência">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Aparência" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="sound" AutomationProperties.Name="Som">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE767;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Som" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="general" AutomationProperties.Name="Geral">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE713;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Geral" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="connections" AutomationProperties.Name="Twitch">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE77B;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Twitch" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="about" AutomationProperties.Name="Sobre">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Sobre" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- Page area, with a rounded corner against the orange frame -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SettingsPageBrush}" CornerRadius="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Name="SettingsContentControl" Focusable="False" />

                <!-- Bottom bar -->
                <Border Grid.Row="1" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Salvar applies right away and keeps the window open -->
                        <Button
                            Name="OKButton"
                            Grid.Column="1"
                            Content="Salvar"
                            Style="{StaticResource SettingsPrimaryButton}"
                            Margin="16,0,8,0"
                            ToolTip="Salva e aplica no chat na hora"
                            Click="OKButton_Click"
                            IsDefault="True" />

                        <Button
                            Name="CloseButton"
                            Grid.Column="2"
                            Content="Fechar"
                            Style="{StaticResource SettingsSecondaryButton}"
                            Click="CloseButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
