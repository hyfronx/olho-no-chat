<UserControl x:Class="OlhoNoChat.View.Settings.AboutSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:onc="clr-namespace:OlhoNoChat"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600">

    <UserControl.Resources>
        <!-- Chat bubbles drawn faintly on the orange banner -->
        <Style x:Key="BannerBubble" TargetType="ui:FontIcon">
            <Setter Property="Glyph" Value="&#xE8BD;" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SettingsPageScroll}">
        <StackPanel Style="{StaticResource SettingsPagePanel}">

            <!-- App card: orange banner, big icon, name, version and tagline -->
            <Border Background="{StaticResource SettingsCardBrush}" BorderBrush="{StaticResource SettingsCardBorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border CornerRadius="9,9,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E85D30" Offset="0" />
                                <GradientStop Color="#F0506E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas ClipToBounds="True">
                            <ui:FontIcon Style="{StaticResource BannerBubble}" FontSize="64" Opacity="0.12" Canvas.Left="22" Canvas.Top="14" />
                            <ui:FontIcon Style="{StaticResource BannerBubble}" FontSize="30" Opacity="0.16" Canvas.Left="104" Canvas.Top="58" />
                            <ui:FontIcon Style="{StaticResource BannerBubble}" FontSize="40" Opacity="0.10" Canvas.Left="150" Canvas.Top="4" />
                            <ui:FontIcon Style="{StaticResource BannerBubble}" FontSize="34" Opacity="0.14" Canvas.Right="118" Canvas.Top="10" />
                            <ui:FontIcon Style="{StaticResource BannerBubble}" FontSize="72" Opacity="0.10" Canvas.Right="20" Canvas.Top="30" />
                        </Canvas>
                    </Border>

                    <!-- Icon on a dark plate, half over the banner -->
                    <Border Grid.RowSpan="2" Width="116" Height="116" CornerRadius="28" Margin="0,46,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="#1C1C1C" BorderBrush="{StaticResource SettingsCardBrush}" BorderThickness="5">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Image Source="/assets/images/olho_no_chat_256.png" Width="78" Height="78"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24,70,24,28" HorizontalAlignment="Center">
                        <TextBlock Text="Olho no Chat" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />

                        <Border HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,4" CornerRadius="12"
                                Background="#33E85D30" BorderBrush="#99E85D30" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Versão " Foreground="{StaticResource SettingsAccentLightBrush}" FontWeight="SemiBold" />
                                <TextBlock x:Name="tbVersion" Text="{x:Static onc:InfoDoApp.Versao}" Foreground="{StaticResource SettingsAccentLightBrush}" FontWeight="SemiBold" />
                                <TextBlock Text=" (portátil)" Foreground="{StaticResource SettingsAccentLightBrush}" FontWeight="SemiBold"
                                           Visibility="{Binding Path=(onc:InfoDoApp.EhPortatil), Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Fique de olho no chat da sua live sem sair do jogo."
                                   FontSize="15" Foreground="#D6D6D6" Margin="0,16,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Segurança da sua conta" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}" Background="#2A211D" BorderBrush="#4A3226">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xEA18;" Style="{StaticResource SettingsCardIcon}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="A conexão com a Twitch é feita no seu navegador" Style="{StaticResource SettingsLabel}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SettingsHint}" Foreground="#E6D6CF" FontSize="13" Margin="0,4,0,0">
                            <Run Text="O Olho no Chat nunca vê a sua senha. Na sua conta da Twitch, ele aparece como &quot;Olho no Chat&quot; em Configurações &gt; Conexões, e você pode desconectar a qualquer momento: lá ou aqui, na aba Twitch." />
                            <LineBreak />
                            <Hyperlink NavigateUri="https://www.twitch.tv/settings/connections" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{StaticResource SettingsAccentLightBrush}">
                                <Run Text="Abrir as conexões da sua conta da Twitch" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Links" Style="{StaticResource SettingsSectionTitle}" />
            <Button Style="{StaticResource SettingsCardButton}" Tag="https://github.com/hyfronx/olho-no-chat" Click="Link_Click"
                    AutomationProperties.Name="Página do projeto e código-fonte">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE71B;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Página do projeto e código-fonte" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="Abre no navegador." Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ui:FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
