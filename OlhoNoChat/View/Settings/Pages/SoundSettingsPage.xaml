<UserControl x:Class="OlhoNoChat.View.Settings.SoundSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600">

    <ScrollViewer Style="{StaticResource SettingsPageScroll}">
        <StackPanel Style="{StaticResource SettingsPagePanel}">
            <TextBlock Text="Som" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="Um aviso sonoro quando chega mensagem nova no chat." Style="{StaticResource SettingsPageSubtitle}" />

            <TextBlock Text="Aviso de nova mensagem" Style="{StaticResource SettingsSectionTitle}" />
            <!-- The sound only plays with the default chat -->
            <Border Name="chatSoundCard" Style="{StaticResource SettingsCard}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xEA8F;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Som" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="Ao escolher um som, ele toca uma vez para você ouvir." Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ComboBox Name="comboChatSound" Grid.Column="2" Style="{StaticResource SettingsComboBox}" Width="190"
                              AutomationProperties.Name="Som de nova mensagem"
                              SelectedValuePath="Tag" DropDownClosed="comboChatSound_DropDownClosed" />
                    <Button Name="btPlaySound" Grid.Column="3" Margin="8,0,0,0" Height="32" VerticalAlignment="Center"
                            ToolTip="Ouvir o som escolhido" AutomationProperties.Name="Ouvir" Click="btPlaySound_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE768;" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SettingsAccentLightBrush}" />
                            <TextBlock Text="Ouvir" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Rectangle Style="{StaticResource SettingsCardDivider}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE916;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Quando tocar" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="A primeira mensagem toca; as seguintes só depois desse tempo."
                                   Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ComboBox Name="comboSoundQuiet" Grid.Column="2" Style="{StaticResource SettingsComboBox}" Width="260"
                              AutomationProperties.Name="Quando tocar o som">
                        <ComboBoxItem Tag="0" Content="Em toda mensagem nova" />
                        <ComboBoxItem Tag="10" Content="No máximo 1 vez a cada 10 s" />
                        <ComboBoxItem Tag="30" Content="No máximo 1 vez a cada 30 s" />
                        <ComboBoxItem Tag="60" Content="No máximo 1 vez a cada 1 min" />
                        <ComboBoxItem Tag="120" Content="No máximo 1 vez a cada 2 min" />
                        <ComboBoxItem Tag="300" Content="No máximo 1 vez a cada 5 min" />
                    </ComboBox>
                </Grid>
                </StackPanel>
            </Border>
            <Border Name="chatSoundUnavailable" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIcon}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"
                               Text="O aviso de nova mensagem só funciona com o tipo de chat Padrão." />
                </Grid>
            </Border>

            <TextBlock Text="Onde tocar" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE7F5;" Style="{StaticResource SettingsCardIcon}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                            <TextBlock Text="Saída de som" Style="{StaticResource SettingsLabel}" />
                            <TextBlock Text="Fone, caixa de som ou outro aparelho." Style="{StaticResource SettingsHint}" />
                        </StackPanel>
                        <ComboBox x:Name="DevicesComboBox" Grid.Column="2" Style="{StaticResource SettingsComboBox}" Width="260"
                                  AutomationProperties.Name="Saída de som" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsCardDivider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE767;" Style="{StaticResource SettingsCardIcon}" />
                        <TextBlock Grid.Column="1" Text="Volume" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Slider x:Name="OutputVolumeSlider" Grid.Column="2" Width="220" VerticalAlignment="Center"
                                AutomationProperties.Name="Volume"
                                Value="100" IsSnapToTickEnabled="False" TickFrequency="5" Minimum="0" Maximum="100"
                                SmallChange="5" LargeChange="10" />
                        <TextBlock Grid.Column="3" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding Value, ElementName=OutputVolumeSlider, StringFormat={}{0:0}%}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Seus próprios sons" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingsCardIcon}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pasta dos sons" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="Os arquivos .wav e .mp3 dessa pasta aparecem na lista de sons." Style="{StaticResource SettingsHint}" />
                        <TextBlock Name="tbSoundClipsFolder" TextWrapping="Wrap" Foreground="White" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Name="btChangeSoundClipsFolder" Content="Escolher pasta..." Click="btChangeSoundClipsFolder_Click" />
                            <Button Name="btDefaultSoundClipsFolder" Margin="8,0,0,0" Content="Usar a pasta padrão" Click="btDefaultSoundClipsFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
