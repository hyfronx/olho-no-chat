<UserControl x:Class="OlhoNoChat.View.Settings.ConnectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">
    <ScrollViewer Style="{StaticResource SettingsPageScroll}">
        <StackPanel Style="{StaticResource SettingsPagePanel}">
            <TextBlock Text="Twitch" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="Sua conta da Twitch no Olho no Chat." Style="{StaticResource SettingsPageSubtitle}" />

            <TextBlock Text="Conta" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Profile picture (or a person icon while not connected) -->
                        <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse Fill="#3A3A3A" />
                            <ui:FontIcon Name="iconNoAccount" Glyph="&#xE77B;" FontSize="20" Foreground="#A6A6A6" />
                            <Ellipse Name="imgAccount" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="imgAccountBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                            <TextBlock Name="lblAccount" Text="Não conectado" Style="{StaticResource SettingsLabel}"
                                       AutomationProperties.AutomationId="lblAccount" />
                            <TextBlock Name="lblAccountHint" Style="{StaticResource SettingsHint}"
                                       Text="Para só ler o chat, não precisa conectar." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="btConnect" Content="Conectar" MinWidth="110"
                                    Style="{StaticResource SettingsPrimaryButton}" Click="btConnect_Click" />
                            <Button Name="btCancelConnect" Content="Cancelar" MinWidth="100" Visibility="Collapsed"
                                    Style="{StaticResource SettingsSecondaryButton}" Click="btCancelConnect_Click" />
                            <Button Name="btDisconnect" Content="Desconectar" MinWidth="110" Visibility="Collapsed"
                                    Style="{StaticResource SettingsSecondaryButton}" Click="btDisconnect_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- How "Conectar" works -->
            <Border Style="{StaticResource SettingsCard}" Background="#2A211D" BorderBrush="#4A3226" Margin="0,10,0,0" MinHeight="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIcon}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SettingsHint}" Margin="0" FontSize="13" Foreground="#E6D6CF"
                               Text="Conectar abre a Twitch no seu navegador. Se você já estiver logado nele, é só clicar em &quot;Autorizar&quot;. O Olho no Chat nunca vê a sua senha e você pode tirar o acesso quando quiser, aqui ou nas configurações da sua conta da Twitch (Conexões)." />
                </Grid>
            </Border>

            <TextBlock Text="Escrever no chat" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE8BD;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Caixa de digitar" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Name="lblChatBoxHint" Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ComboBox Name="comboChatBox" Grid.Column="2" Style="{StaticResource SettingsComboBox}"
                              AutomationProperties.Name="Caixa de digitar" SelectionChanged="comboChatBox_SelectionChanged">
                        <ComboBoxItem Tag="app" Content="Do Olho no Chat" />
                        <ComboBoxItem Tag="twitch" Content="Da própria Twitch" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE724;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Fechar a caixa depois de enviar" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Name="lblCloseAfterSendHint" Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch Name="cbCloseAfterSend" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                     AutomationProperties.Name="Fechar a caixa depois de enviar" />
                </Grid>
            </Border>

            <TextBlock Text="Resgates de pontos do canal" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE734;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Mostrar os resgates no chat" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="Só os resgates do canal da conta conectada. Aparecem apenas no chat Padrão." />
                    </StackPanel>
                    <ui:ToggleSwitch Name="cbRedemptions" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                     AutomationProperties.Name="Mostrar os resgates no chat" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
