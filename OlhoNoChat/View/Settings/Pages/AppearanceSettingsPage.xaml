<UserControl x:Class="OlhoNoChat.View.Settings.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600">
    <ScrollViewer Style="{StaticResource SettingsPageScroll}">
        <StackPanel Style="{StaticResource SettingsPagePanel}">
            <TextBlock Text="Aparência" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="Como as mensagens aparecem por cima do jogo." Style="{StaticResource SettingsPageSubtitle}" />

            <!-- Padrão (KapChat) -->
            <StackPanel Name="kapChatAppearance">
                <TextBlock Text="Tema" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Tema do chat" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Cores e estilo das mensagens." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <ComboBox Name="comboTheme" Grid.Column="2" Style="{StaticResource SettingsComboBox}"
                                      AutomationProperties.Name="Tema do chat"
                                      SelectionChanged="comboTheme_SelectionChanged">
                                <!-- The position of each item is the saved ThemeIndex (see GeneralSettings.ThemeIndex): keep the order -->
                                <ComboBoxItem Content="Nenhum (CSS personalizado)" />
                                <ComboBoxItem Content="Padrão" />
                            </ComboBox>
                        </Grid>
                        <StackPanel Name="lblCSS" Visibility="Collapsed">
                            <Rectangle Style="{StaticResource SettingsCardDivider}" />
                            <TextBlock Text="CSS personalizado" Style="{StaticResource SettingsLabel}" />
                            <TextBox Name="tbCSS"
                                     Height="110"
                                     Margin="0,8,0,0"
                                     FontFamily="Consolas"
                                     AutomationProperties.Name="CSS personalizado"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" AcceptsReturn="true"
                                     Text="body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- "Padrão" and "Chat oficial da Twitch" (which copies the look of the "Padrão") -->
            <StackPanel Name="messageTextAppearance">
                <TextBlock Text="Texto das mensagens" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE8D3;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Cor" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Muda só o texto. A cor dos nomes continua a da Twitch." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <ComboBox Name="comboTextColor" Grid.Column="2" Style="{StaticResource SettingsComboBox}" AutomationProperties.Name="Cor do texto">
                                <ComboBoxItem Tag="" AutomationProperties.Name="Padrão do tema">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ColorSwatch}" BorderBrush="#888" BorderThickness="1" />
                                        <TextBlock Text="Padrão do tema" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="#FFFFFF" AutomationProperties.Name="Branco"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#FFFFFF" /><TextBlock Text="Branco" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#FFF3A6" AutomationProperties.Name="Amarelo claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#FFF3A6" /><TextBlock Text="Amarelo claro" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#B8F5B0" AutomationProperties.Name="Verde claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#B8F5B0" /><TextBlock Text="Verde claro" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#A8DCFF" AutomationProperties.Name="Azul claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#A8DCFF" /><TextBlock Text="Azul claro" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#FFB8E0" AutomationProperties.Name="Rosa claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#FFB8E0" /><TextBlock Text="Rosa claro" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#FFC9A0" AutomationProperties.Name="Laranja claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#FFC9A0" /><TextBlock Text="Laranja claro" /></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="#D0D0D0" AutomationProperties.Name="Cinza claro"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ColorSwatch}" Background="#D0D0D0" /><TextBlock Text="Cinza claro" /></StackPanel></ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Rectangle Style="{StaticResource SettingsCardDivider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE8E9;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Contorno das letras" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Ajuda a ler o chat em cima de partes claras do jogo." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <ComboBox Name="comboTextOutline" Grid.Column="2" Style="{StaticResource SettingsComboBox}" AutomationProperties.Name="Contorno das letras">
                                <ComboBoxItem Tag="theme" Content="Contorno preto" />
                                <ComboBoxItem Tag="soft" Content="Sombra suave" />
                                <ComboBoxItem Tag="none" Content="Nenhum" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Style="{StaticResource SettingsCardDivider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE8D2;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Fonte" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="O tipo de letra das mensagens." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <ComboBox Name="comboTextFont" Grid.Column="2" Style="{StaticResource SettingsComboBox}" AutomationProperties.Name="Fonte">
                                <ComboBoxItem Tag="theme" Content="Padrão do tema" />
                                <ComboBoxItem Tag="Segoe UI" Content="Segoe UI (a do Windows)" FontFamily="Segoe UI" />
                                <ComboBoxItem Tag="Arial" Content="Arial" FontFamily="Arial" />
                                <ComboBoxItem Tag="Verdana" Content="Verdana" FontFamily="Verdana" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Style="{StaticResource SettingsCardDivider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE823;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Mostrar o horário das mensagens" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="A hora em que cada mensagem chegou, antes do nome." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Name="cbShowMessageTime" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                             AutomationProperties.Name="Mostrar o horário das mensagens" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Where the other look options live -->
                <Border Style="{StaticResource SettingsCard}" Background="#2A211D" BorderBrush="#4A3226" Margin="0,14,0,0" MinHeight="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIcon}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsHint}" Margin="0" FontSize="13" Foreground="#E6D6CF"
                                   Text="As mudanças aparecem no chat quando você clicar em Salvar. O tamanho do texto e o fundo do chat ficam na barra laranja ao lado do chat (com as bordas visíveis)." />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Chat oficial da Twitch (popout) -->
            <StackPanel Name="twitchPopoutAppearance" Visibility="Collapsed">
                <TextBlock Text="Aparência (CSS)" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsCardIcon}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                            <TextBlock Text="Usar a aparência padrão" Style="{StaticResource SettingsLabel}" />
                            <TextBlock Text="Desligue para editar o CSS abaixo." Style="{StaticResource SettingsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Name="cbUseDefaultPopoutCSS" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                         AutomationProperties.Name="Usar a aparência padrão"
                                         Toggled="cbUseDefaultPopoutCSS_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCodeEditorBorder}">
                    <avalonedit:TextEditor Name="tbPopoutCSS"
                        Background="Transparent"
                        Foreground="#1E1E1E"
                        FontFamily="Consolas"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        WordWrap="False"
                        Text="" />
                </Border>
            </StackPanel>

            <!-- Endereço personalizado -->
            <StackPanel Name="customURLAppearance" Visibility="Collapsed">
                <TextBlock Text="Aparência (CSS personalizado)" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsCodeEditorBorder}">
                    <avalonedit:TextEditor Name="tbCSS2"
                         Background="Transparent"
                         Foreground="#1E1E1E"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         WordWrap="False"
                         Text="body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
