<UserControl x:Class="OlhoNoChat.View.Settings.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:onc="clr-namespace:OlhoNoChat"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600">
    <UserControl.Resources>
        <Style x:Key="HotkeyRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SettingsPageScroll}">
        <StackPanel Name="generalGrid" Style="{StaticResource SettingsPagePanel}">
            <TextBlock Text="Geral" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="Como a janela do chat se comporta." Style="{StaticResource SettingsPageSubtitle}" />

            <TextBlock Text="Janela do chat" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xED1A;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Esconder as bordas ao abrir o app" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="O chat já abre pronto para o jogo, só com as mensagens." Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch Name="cbAutoHideBorders" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                     AutomationProperties.Name="Esconder as bordas ao abrir o app" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE8B0;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Permitir clicar no chat com as bordas visíveis" Style="{StaticResource SettingsLabel}" />
                    </StackPanel>
                    <ui:ToggleSwitch Name="cbInteraction" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                     AutomationProperties.Name="Permitir clicar no chat com as bordas visíveis" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE75B;" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                        <TextBlock Text="Esconder o ícone da barra de tarefas" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Text="Some da barra de tarefas enquanto as bordas estão ocultas. Para abrir o menu, use o ícone do app perto do relógio do Windows." Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch Name="cbTaskbar" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                     AutomationProperties.Name="Esconder o ícone da barra de tarefas" />
                </Grid>
            </Border>

            <TextBlock Text="Atalhos de teclado" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <ToggleButton Name="cbShowHotkeys" Style="{StaticResource SettingsExpanderHeader}" AutomationProperties.Name="Mostrar atalhos de teclado">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Ver e mudar os atalhos" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Funcionam mesmo com o jogo em primeiro plano." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=cbShowHotkeys, Converter={StaticResource BoolToVisibility}}" Margin="16,0,16,16">
                        <Rectangle Style="{StaticResource SettingsCardDivider}" Margin="-16,0,-16,4" />
                        <TextBlock Style="{StaticResource SettingsHint}" Margin="0,4,0,4"
                                   Text="Use combinações com Ctrl, Alt ou Shift para não atrapalhar outros programas. Para apagar um atalho, clique em &quot;Mudar atalho&quot; e aperte Esc, Delete ou Backspace." />

                        <Grid Style="{StaticResource HotkeyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mostrar/esconder as bordas" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                            <onc:HotkeyEditorControl x:Name="hotkeyInputToggleBorders" Grid.Column="1" Width="180" />
                            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="110" Name="btCaptureHotkeyToggleBorders" Content="Mudar atalho" Click="CaptureHotkey_Click" />
                        </Grid>

                        <Grid Style="{StaticResource HotkeyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Modo rolagem (rolar o chat com o mouse)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                            <onc:HotkeyEditorControl x:Name="hotkeyInputToggleInteractable" Grid.Column="1" Width="180" />
                            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="110" Name="btCaptureHotkeyInteractable" Content="Mudar atalho" Click="CaptureHotkey_Click" />
                        </Grid>

                        <Grid Style="{StaticResource HotkeyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sempre no topo (ligar/desligar)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                            <onc:HotkeyEditorControl x:Name="hotkeyInputBringToTop" Grid.Column="1" Width="180" />
                            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="110" Name="btCaptureHotkeyBringToTop" Content="Mudar atalho" Click="CaptureHotkey_Click" />
                        </Grid>

                        <Grid Style="{StaticResource HotkeyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Escrever no chat (conta da Twitch conectada)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <onc:HotkeyEditorControl x:Name="hotkeyInputWriteMessage" Grid.Column="1" Width="180" />
                            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="110" Name="btCaptureHotkeyWriteMessage" Content="Mudar atalho" Click="CaptureHotkey_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Atualizações" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsCardIcon}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                            <TextBlock Text="Procurar atualizações ao abrir o app" Style="{StaticResource SettingsLabel}" />
                            <TextBlock Text="Avisa quando tiver uma versão nova." Style="{StaticResource SettingsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Name="cbCheckForUpdates" Grid.Column="2" Style="{StaticResource SettingsToggle}"
                                         AutomationProperties.Name="Procurar atualizações ao abrir o app" />
                    </Grid>
                    <Rectangle Style="{StaticResource SettingsCardDivider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingsHint}" Margin="0" FontSize="13">
                            <Run Text="Versão atual:" />
                            <Run Text="{x:Static onc:AppInfo.Version}" Foreground="White" />
                        </TextBlock>
                        <Button Name="btnCheckForUpdatesNow" Grid.Column="1" Content="Procurar agora" MinWidth="130" Click="btnCheckForUpdatesNow_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Avançado" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <ToggleButton Name="cbShowAdvanced" Style="{StaticResource SettingsExpanderHeader}" AutomationProperties.Name="Mostrar opções avançadas">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE9F5;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowText}">
                                <TextBlock Text="Mostrar opções avançadas" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Coisas que quase ninguém precisa mudar." Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=cbShowAdvanced, Converter={StaticResource BoolToVisibility}}" Margin="16,0,16,14">
                        <Rectangle Style="{StaticResource SettingsCardDivider}" Margin="-16,0,-16,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingsRowText}" Margin="36,0,16,0">
                                <TextBlock Text="Permitir abrir mais de uma cópia do app (beta)" Style="{StaticResource SettingsLabel}" />
                            </StackPanel>
                            <ui:ToggleSwitch Name="cbMultiInstance" Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                             AutomationProperties.Name="Permitir abrir mais de uma cópia do app" />
                        </Grid>
                        <Rectangle Style="{StaticResource SettingsCardDivider}" Margin="-16,12,-16,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingsRowText}" Margin="36,0,16,0">
                                <TextBlock Text="Restaurar tudo para o padrão" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Text="Todas as opções voltam como na primeira instalação. O canal, a conta da Twitch e as listas de nomes dos filtros continuam."
                                           Style="{StaticResource SettingsHint}" />
                            </StackPanel>
                            <Button Name="btnResetToDefaults" Grid.Column="1" Content="Restaurar" MinWidth="130" VerticalAlignment="Center"
                                    AutomationProperties.Name="Restaurar tudo para o padrão" Click="btnResetToDefaults_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
