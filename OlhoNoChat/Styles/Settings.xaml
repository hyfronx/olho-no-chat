<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- Rounder, softer controls in every window. The colors live in the styles: each window applies
         ModernWpf's dark theme itself, which would hide app-wide values. -->
    <Style x:Key="{x:Type ComboBox}" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8" />
        <Style.Resources>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#333333" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#3B3B3B" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2C2C2C" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#333333" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#333333" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#444444" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF8A65" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#E85D30" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF8A65" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#282828" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#484848" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#4DE85D30" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#66E85D30" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#80E85D30" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#4DE85D30" />
        </Style.Resources>
    </Style>
    <!-- Items of the open list: rounded highlight with a little room around it -->
    <Style x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8" />
    </Style>
    <Style x:Key="{x:Type TextBox}" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8" />
    </Style>

    <!-- Look of the Settings window: orange frame like the main window, dark pages with rounded cards -->
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#E85D30" />
    <SolidColorBrush x:Key="SettingsAccentLightBrush" Color="#FF8A65" />
    <SolidColorBrush x:Key="SettingsPageBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#282828" />
    <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#303030" />
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="SettingsHintBrush" Color="#A6A6A6" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Taller title bar for the orange frame (Settings and Chat Filters windows) -->
    <Style x:Key="SettingsTitleBarStyle" TargetType="ui:TitleBarControl">
        <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        <Setter Property="Height" Value="44" />
    </Style>

    <!-- The thin scroll bar of the new windows (Estilos/Rolagem.xaml), so every window looks the same -->
    <Style x:Key="SettingsPageScroll" TargetType="ScrollViewer">
        <Style.Resources>
            <ResourceDictionary Source="/OlhoNoChat;component/Estilos/Rolagem.xaml" />
        </Style.Resources>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{DynamicResource ModeloDaRolagem}" />
    </Style>

    <Style x:Key="SettingsPagePanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="28,20,28,16" />
    </Style>

    <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="SettingsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SettingsHintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,6" />
    </Style>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SettingsAccentLightBrush}" />
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="60" />
    </Style>

    <!-- Thin line between two rows of the same card -->
    <Style x:Key="SettingsCardDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource SettingsCardBorderBrush}" />
        <Setter Property="Margin" Value="-16,12" />
    </Style>

    <Style x:Key="SettingsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SettingsHintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Text + description on the left of a card row -->
    <Style x:Key="SettingsRowText" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- Rows that depend on another option look faded while that option is off -->
    <Style x:Key="SettingsDependentRow" TargetType="FrameworkElement">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card icon on the left (Segoe Fluent / MDL2 glyph) -->
    <Style x:Key="SettingsCardIcon" TargetType="ui:FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SettingsAccentLightBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,16,0" />
    </Style>

    <!-- On/off switch on the right of a card row. Fixed width keeps every knob in the same column. -->
    <Style x:Key="SettingsToggle" TargetType="ui:ToggleSwitch">
        <Setter Property="OnContent" Value="Ligado" />
        <Setter Property="OffContent" Value="Desligado" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="122" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="230" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Colour sample before the name in a colour list -->
    <Style x:Key="ColorSwatch" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Main action (Salvar) -->
    <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SettingsSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!-- A whole card that can be clicked (opens a window or a link) -->
    <Style x:Key="SettingsCardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="#242424" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SettingsAccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header of a card that opens and closes (hotkeys, advanced options) -->
    <Style x:Key="SettingsExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Header" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <ui:FontIcon x:Name="Chevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" Margin="16,0,6,0"
                                         VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ui:FontIcon.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </ui:FontIcon.RenderTransform>
                            </ui:FontIcon>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="#0DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Items of the orange navigation column -->
    <Style x:Key="SettingsNavItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="8" />
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" Background="White"
                                HorizontalAlignment="Left" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#1F000000" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#40000000" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsNavIcon" TargetType="ui:FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- CSS editors (custom chat themes). Light background: the CSS colouring is made for it. -->
    <Style x:Key="SettingsCodeEditorBorder" TargetType="Border">
        <Style.Resources>
            <ResourceDictionary Source="/OlhoNoChat;component/Estilos/Rolagem.xaml" />
        </Style.Resources>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#E8E8E8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Height" Value="260" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
</ResourceDictionary>
