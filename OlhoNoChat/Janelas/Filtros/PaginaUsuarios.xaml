<UserControl x:Class="OlhoNoChat.Janelas.Filtros.PaginaUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             xmlns:local="clr-namespace:OlhoNoChat.Janelas.Filtros">
    <!-- Os estilos com nome vêm da janela (Estilos/Controles.xaml): DynamicResource, porque a página é montada antes
         de entrar nela. DataContext = LogicaFiltros. -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />

        <!-- Um item das listas de cores: amostra + nome; a "Personalizada…" sem cor válida fica só com o contorno -->
        <DataTemplate x:Key="ModeloDoItemDeCor" DataType="{x:Type local:ItemDeCor}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Amostra" Style="{DynamicResource AmostraDeCor}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding Amostra, TargetNullValue=Transparent}" />
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Amostra}" Value="{x:Null}">
                    <Setter TargetName="Amostra" Property="BorderThickness" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Um nome da lista, com o "×" que o tira só desta lista -->
        <DataTemplate x:Key="FichaDoUsuario">
            <Border Style="{DynamicResource Ficha}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    <Button Style="{DynamicResource BotaoDaFicha}"
                            AutomationProperties.Name="{Binding StringFormat='Tirar {0} da lista'}"
                            Command="{Binding DataContext.TirarUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Usuários" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="Destaque algumas pessoas no chat ou mostre só as mensagens delas." Style="{DynamicResource SubtituloDaPagina}" />

            <!-- Lista de usuários (primeiro a lista, depois o que fazer com ela) -->
            <TextBlock Text="Lista de usuários" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Enter adiciona o nome (em vez de salvar a janela) -->
                        <TextBox x:Name="caixaNovoUsuario" ctl:CaixaDeTexto.TextoDeExemplo="Nome ou @ do usuário"
                                 AutomationProperties.Name="Nome do usuário para adicionar à lista"
                                 Text="{Binding NovoUsuario, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AdicionarUsuarioCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="botaoAdicionar" Grid.Column="1" Margin="8,0,0,0" MinWidth="110" AutomationProperties.Name="Adicionar"
                                Command="{Binding AdicionarUsuarioCommand}" Click="BotaoAdicionar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{DynamicResource Icone}" FontSize="12" />
                                <TextBlock Text="Adicionar" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="erroNovoUsuario" Text="{Binding ErroNovoUsuario}" Style="{DynamicResource Erro}" Margin="2,6,0,0"
                               Visibility="{Binding ErroNovoUsuario, Converter={StaticResource VisivelSe}}" />
                    <ItemsControl x:Name="listaDeUsuarios" Margin="0,12,0,0" Focusable="False" AutomationProperties.Name="Lista de usuários"
                                  ItemsSource="{Binding ListaDeUsuarios}" ItemTemplate="{StaticResource FichaDoUsuario}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="listaVazia" Text="Ninguém na lista ainda." Style="{DynamicResource Dica}" Margin="2,2,0,0"
                               Visibility="{Binding ListaVazia, Converter={StaticResource VisivelSe}}" />
                </StackPanel>
            </Border>

            <!-- O que fazer com a lista -->
            <TextBlock Text="O que fazer com a lista" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <RadioButton x:Name="opcaoNada" GroupName="modoDaLista" Margin="0,2" IsChecked="{Binding ModoNada}"
                                 AutomationProperties.Name="Não usar a lista">
                        <StackPanel>
                            <TextBlock Text="Não usar a lista" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="O chat mostra todo mundo igual. A lista fica guardada." Style="{DynamicResource Dica}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="opcaoDestacar" GroupName="modoDaLista" Margin="0,2" IsChecked="{Binding ModoDestacar}"
                                 AutomationProperties.Name="Destacar quem está na lista">
                        <StackPanel>
                            <TextBlock Text="Destacar quem está na lista" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Todo mundo aparece, e quem está na lista ganha um fundo colorido." Style="{DynamicResource Dica}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="opcaoSoALista" GroupName="modoDaLista" Margin="0,2" IsChecked="{Binding ModoSoALista}"
                                 AutomationProperties.Name="Mostrar só quem está na lista">
                        <StackPanel>
                            <TextBlock Text="Mostrar só quem está na lista" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Quem não está na lista não aparece no chat nem no overlay." Style="{DynamicResource Dica}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Só no "Destacar" -->
                    <StackPanel x:Name="linhaCorDoDestaque" Visibility="{Binding CorDoDestaque.Visivel, Converter={StaticResource VisivelSe}}">
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Cor do destaque" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="O fundo das mensagens de quem está na lista." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding CorDoDestaque}">
                                <ComboBox x:Name="listaCorDoDestaque" Width="170" HorizontalAlignment="Right" AutomationProperties.Name="Cor do destaque"
                                          ItemsSource="{Binding Itens}" SelectedItem="{Binding Escolhida}" ItemTemplate="{StaticResource ModeloDoItemDeCor}" />
                                <TextBox x:Name="caixaCorDoDestaque" Width="90" Margin="0,6,0,0" HorizontalAlignment="Right"
                                         ctl:CaixaDeTexto.TextoDeExemplo="#FF8A00" AutomationProperties.Name="Cor personalizada"
                                         Text="{Binding TextoPersonalizado, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding MostrarCaixa, Converter={StaticResource VisivelSe}}" LostFocus="CaixaDeCor_LostFocus" />
                                <TextBlock x:Name="erroCorDoDestaque" Text="{x:Static local:CoresDeDestaque.ErroDaPersonalizada}" Style="{DynamicResource Erro}" HorizontalAlignment="Right"
                                           Margin="0,4,0,0" Visibility="{Binding MostrarErro, Converter={StaticResource VisivelSe}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Moderadores e VIPs: não valem no "Nada" (o aviso abaixo diz); as cores somem no "Mostrar só" -->
            <TextBlock Text="Moderadores e VIPs" Style="{DynamicResource TituloDaSecao}" />
            <Border x:Name="cartaoModeradoresEVips" Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid x:Name="linhaModeradores">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE83D;" Style="{DynamicResource IconeDoCartao}" />
                        <TextBlock x:Name="rotuloModeradores" Grid.Column="1" Text="{Binding RotuloModeradores}" Style="{DynamicResource Rotulo}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" DataContext="{Binding CorDosModeradores}"
                                    Visibility="{Binding Visivel, Converter={StaticResource VisivelSe}}">
                            <ComboBox x:Name="listaCorDosModeradores" Width="170" HorizontalAlignment="Right" AutomationProperties.Name="Cor dos moderadores"
                                      ItemsSource="{Binding Itens}" SelectedItem="{Binding Escolhida}" ItemTemplate="{StaticResource ModeloDoItemDeCor}" />
                            <TextBox x:Name="caixaCorDosModeradores" Width="90" Margin="0,6,0,0" HorizontalAlignment="Right"
                                     ctl:CaixaDeTexto.TextoDeExemplo="#FF8A00" AutomationProperties.Name="Cor personalizada"
                                     Text="{Binding TextoPersonalizado, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding MostrarCaixa, Converter={StaticResource VisivelSe}}" LostFocus="CaixaDeCor_LostFocus" />
                            <TextBlock x:Name="erroCorDosModeradores" Text="{x:Static local:CoresDeDestaque.ErroDaPersonalizada}" Style="{DynamicResource Erro}" HorizontalAlignment="Right"
                                       Margin="0,4,0,0" Visibility="{Binding MostrarErro, Converter={StaticResource VisivelSe}}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorModeradores" Grid.Column="3" IsChecked="{Binding DestacarModeradores}"
                                         AutomationProperties.Name="Todos os moderadores" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid x:Name="linhaVips">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE734;" Style="{DynamicResource IconeDoCartao}" />
                        <TextBlock x:Name="rotuloVips" Grid.Column="1" Text="{Binding RotuloVips}" Style="{DynamicResource Rotulo}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" DataContext="{Binding CorDosVips}"
                                    Visibility="{Binding Visivel, Converter={StaticResource VisivelSe}}">
                            <ComboBox x:Name="listaCorDosVips" Width="170" HorizontalAlignment="Right" AutomationProperties.Name="Cor dos VIPs"
                                      ItemsSource="{Binding Itens}" SelectedItem="{Binding Escolhida}" ItemTemplate="{StaticResource ModeloDoItemDeCor}" />
                            <TextBox x:Name="caixaCorDosVips" Width="90" Margin="0,6,0,0" HorizontalAlignment="Right"
                                     ctl:CaixaDeTexto.TextoDeExemplo="#FF8A00" AutomationProperties.Name="Cor personalizada"
                                     Text="{Binding TextoPersonalizado, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding MostrarCaixa, Converter={StaticResource VisivelSe}}" LostFocus="CaixaDeCor_LostFocus" />
                            <TextBlock x:Name="erroCorDosVips" Text="{x:Static local:CoresDeDestaque.ErroDaPersonalizada}" Style="{DynamicResource Erro}" HorizontalAlignment="Right"
                                       Margin="0,4,0,0" Visibility="{Binding MostrarErro, Converter={StaticResource VisivelSe}}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorVips" Grid.Column="3" IsChecked="{Binding DestacarVips}"
                                         AutomationProperties.Name="Todos os VIPs" />
                    </Grid>
                    <!-- O YouTube e o TikTok não têm VIP (browser\chat.js: só dono e moderador) -->
                    <TextBlock x:Name="dicaPlataformas" Text="Moderadores contam em todas as plataformas. VIP só existe na Twitch e na Kick."
                               Style="{DynamicResource Dica}" Margin="36,10,0,0" />
                    <TextBlock x:Name="dicaModeradoresEVips" Text="Para usar, escolha &quot;Destacar&quot; ou &quot;Mostrar só&quot; acima."
                               Style="{DynamicResource Dica}" Margin="36,3,0,0"
                               Visibility="{Binding ModeradoresEVipsAtivos, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CartaoDeAviso}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                               Text="Com &quot;Destacar&quot; ou &quot;Mostrar só&quot;, o som de nova mensagem (aba Som) só toca para as pessoas escolhidas aqui." />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
