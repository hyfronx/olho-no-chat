<janelas:JanelaComMoldura x:Class="OlhoNoChat.Janelas.Filtros.JanelaFiltros"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:janelas="clr-namespace:OlhoNoChat.Janelas"
                          xmlns:local="clr-namespace:OlhoNoChat.Janelas.Filtros"
                          Title="Filtros do chat" Icone="&#xE71C;" LarguraDaNavegacao="170"
                          Icon="/icons/olho_no_chat.ico"
                          Height="700" Width="840" MinHeight="460" MinWidth="660"
                          Topmost="True" WindowStartupLocation="CenterOwner"
                          FocusManager.FocusedElement="{Binding ElementName=listaDePaginas}">
    <!-- Filtros do chat: abre sobre Configurações (aba Chat, só no tipo Padrão) e salva sozinha -->
    <janelas:JanelaComMoldura.Navegacao>
        <ListBox x:Name="listaDePaginas" Style="{StaticResource ListaDeNavegacao}" ItemContainerStyle="{StaticResource ItemDaNavegacao}"
                 SelectedIndex="0" SelectionChanged="ListaDePaginas_SelectionChanged">
            <ListBoxItem AutomationProperties.Name="Usuários">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE716;" Style="{StaticResource IconeDaNavegacao}" />
                    <TextBlock Text="Usuários" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Bloqueios">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F8;" Style="{StaticResource IconeDaNavegacao}" />
                    <TextBlock Text="Bloqueios" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>
    </janelas:JanelaComMoldura.Navegacao>

    <Grid>
        <local:PaginaUsuarios x:Name="paginaUsuarios" />
        <local:PaginaBloqueios x:Name="paginaBloqueios" Visibility="Collapsed" />
    </Grid>
</janelas:JanelaComMoldura>
