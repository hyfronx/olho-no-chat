<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaAparencia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             xmlns:local="clr-namespace:OlhoNoChat.Janelas.Configuracoes">
    <!-- DataContext = LogicaAparencia. Os estilos com nome vêm da janela (DynamicResource). -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />

        <!-- Cor do texto: amostra + nome; "Padrão do tema" só com o contorno -->
        <DataTemplate x:Key="ModeloDaCor" DataType="{x:Type local:OpcaoDaLista}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Amostra" Style="{DynamicResource AmostraDeCor}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding Amostra, TargetNullValue=Transparent}" />
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Amostra}" Value="{x:Null}">
                    <Setter TargetName="Amostra" Property="BorderThickness" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Fonte: cada nome escrito na própria fonte -->
        <DataTemplate x:Key="ModeloDaFonte" DataType="{x:Type local:OpcaoDaLista}">
            <TextBlock Text="{Binding Nome}" FontFamily="{Binding Fonte}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Aparência" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="Como as mensagens aparecem na janela do chat. O visual do overlay fica na aba Overlay." Style="{DynamicResource SubtituloDaPagina}" />

            <!-- Padrão: tema e o CSS do tema "Nenhum" (uma linha só: sem título de seção, como o tipo de chat na aba Chat) -->
            <Border x:Name="painelTema" Style="{DynamicResource Cartao}" Margin="0,14,0,4"
                    Visibility="{Binding ComPadrao, Converter={StaticResource VisivelSe}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE790;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Tema do chat" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Padrão: letras brancas em negrito. Nenhum: você escreve o visual em CSS." Style="{DynamicResource Dica}" />
                            <!-- Só com um tema diferente do salvo: o tema faz parte da página do chat, que recarrega ao salvar -->
                            <TextBlock x:Name="avisoTemaRecarrega" Text="Ao salvar, o chat recarrega e as mensagens da tela somem." Style="{DynamicResource Erro}"
                                       Margin="0,6,0,0" Visibility="{Binding TemaRecarregaOChat, Converter={StaticResource VisivelSe}}" />
                        </StackPanel>
                        <ComboBox x:Name="listaTema" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Tema do chat"
                                  ItemsSource="{x:Static local:LogicaAparencia.Temas}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Tema}" />
                    </Grid>
                    <StackPanel x:Name="painelCssDoTemaNenhum" Visibility="{Binding MostrarCssDoTemaNenhum, Converter={StaticResource VisivelSe}}">
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <TextBlock Text="CSS personalizado" Style="{DynamicResource Rotulo}" />
                        <TextBlock Text="Fica no lugar do visual do app, sem as cores de destaque dos Filtros do chat; o Texto das mensagens, abaixo, continua valendo."
                                   Style="{DynamicResource Dica}" />
                        <TextBox x:Name="caixaCssDoTemaNenhum" Style="{DynamicResource CaixaDeVariasLinhas}" Height="110" Margin="0,8,0,0"
                                 AutomationProperties.Name="CSS personalizado"
                                 Text="{Binding CssDoTemaNenhum, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Padrão e Chat oficial da Twitch (que imita o Padrão). Cor, contorno e fonte ficam desbotados no chat oficial
                 com o CSS próprio (não valem); o horário vale sempre -->
            <StackPanel x:Name="painelTextoDasMensagens" Visibility="{Binding ComTextoDasMensagens, Converter={StaticResource VisivelSe}}">
                <TextBlock Text="Texto das mensagens" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <StackPanel>
                        <Grid x:Name="linhaCorDoTexto" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding CorContornoEFonteValem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D3;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Cor do texto" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Os nomes continuam na cor de cada pessoa." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaCorDoTexto" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Cor do texto"
                                      ItemsSource="{x:Static local:LogicaAparencia.Cores}" ItemTemplate="{StaticResource ModeloDaCor}"
                                      SelectedValuePath="Valor" SelectedValue="{Binding CorDoTexto}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid x:Name="linhaContorno" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding CorContornoEFonteValem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8E9;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Contorno das letras" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Ajuda a ler o chat em cima de partes claras do jogo." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaContorno" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Contorno das letras"
                                      ItemsSource="{x:Static local:LogicaAparencia.Contornos}" DisplayMemberPath="Nome"
                                      SelectedValuePath="Valor" SelectedValue="{Binding ContornoDasLetras}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid x:Name="linhaFonte" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding CorContornoEFonteValem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D2;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Fonte" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="O tipo de letra das mensagens." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaFonte" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Fonte"
                                      ItemsSource="{x:Static local:LogicaAparencia.Fontes}" ItemTemplate="{StaticResource ModeloDaFonte}"
                                      SelectedValuePath="Valor" SelectedValue="{Binding Fonte}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Horário das mensagens" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="A hora em que cada mensagem chegou, como 21:05, antes do nome." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorHorario" Grid.Column="2" IsChecked="{Binding MostrarHorario}"
                                             AutomationProperties.Name="Horário das mensagens" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CartaoDeAviso}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                                   Text="O tamanho do texto e o fundo do chat ficam na barra laranja, em cima do chat (com as bordas visíveis), e mudam na hora." />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Chat oficial da Twitch -->
            <StackPanel x:Name="painelCssDoChatOficial" Visibility="{Binding ComChatOficial, Converter={StaticResource VisivelSe}}">
                <TextBlock Text="CSS do chat oficial" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE790;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Usar a aparência padrão" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Desligue para editar o CSS abaixo. Com o seu CSS, a cor do texto, o contorno e a fonte de cima deixam de valer." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorAparenciaPadrao" Grid.Column="2" IsChecked="{Binding AparenciaPadraoNoChatOficial}"
                                         AutomationProperties.Name="Usar a aparência padrão" />
                    </Grid>
                </Border>
                <TextBlock Text="O visual da página do chat da Twitch; o horário e as partes da página escondidas na aba Chat valem com qualquer CSS."
                           Style="{DynamicResource Dica}" Margin="2,6,0,8" />
                <ctl:EditorDeCss x:Name="editorCssDoChatOficial" AutomationProperties.Name="CSS do chat oficial"
                                 Texto="{Binding TextoDoEditorDoChatOficial}" IsReadOnly="{Binding AparenciaPadraoNoChatOficial}" />
            </StackPanel>

            <!-- Endereço personalizado -->
            <StackPanel x:Name="painelCssDoEndereco" Visibility="{Binding ComEndereco, Converter={StaticResource VisivelSe}}">
                <TextBlock Text="CSS da página" Style="{DynamicResource TituloDaSecao}" />
                <TextBlock Text="É o único visual que o app põe na página do endereço escolhido na aba Chat." Style="{DynamicResource Dica}" Margin="2,0,0,8" />
                <ctl:EditorDeCss x:Name="editorCssDoEndereco" AutomationProperties.Name="CSS da página"
                                 Texto="{Binding CssDoEnderecoPersonalizado}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
