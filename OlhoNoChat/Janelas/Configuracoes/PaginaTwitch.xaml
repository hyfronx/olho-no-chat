<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaTwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             Loaded="Pagina_Loaded" Unloaded="Pagina_Unloaded">
    <!-- DataContext = LogicaTwitch. Os estilos com nome vêm da janela (DynamicResource). -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Twitch" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="Sua conta da Twitch, escrever no chat, resgates de pontos, moderação, AutoMod e anúncios." Style="{DynamicResource SubtituloDaPagina}" />

            <!-- Conta: conectar e desconectar acontecem na hora -->
            <TextBlock Text="Conta" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- A foto do perfil, ou uma pessoa cinza sem conta -->
                    <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse Fill="#3A3A3A" />
                        <TextBlock x:Name="iconeSemConta" Text="&#xE77B;" Style="{DynamicResource Icone}" FontSize="20"
                                   Foreground="{DynamicResource TextoDaDica}" HorizontalAlignment="Center" />
                        <Ellipse x:Name="fotoDaConta" Visibility="{Binding Foto, Converter={StaticResource VisivelSe}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Foto, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock x:Name="textoConta" Text="{Binding TituloDaConta}" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaConta" Text="{Binding DicaDaConta}" Style="{DynamicResource Dica}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="botaoConectar" Content="{Binding TextoConectar}" MinWidth="110" Style="{DynamicResource BotaoPrincipal}"
                                Command="{Binding ConectarCommand}"
                                Visibility="{Binding MostrarConectar, Converter={StaticResource VisivelSe}}" />
                        <Button x:Name="botaoCancelarConexao" Content="Cancelar" MinWidth="100" Command="{Binding CancelarConexaoCommand}"
                                Visibility="{Binding MostrarCancelar, Converter={StaticResource VisivelSe}}" />
                        <Button x:Name="botaoDesconectar" Content="Desconectar" MinWidth="110" Margin="8,0,0,0" Command="{Binding DesconectarCommand}"
                                Visibility="{Binding MostrarDesconectar, Converter={StaticResource VisivelSe}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Só sem conta ou quando falta conectar de novo: como conectar e a segurança da senha -->
            <Border x:Name="avisoDeConectar" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding MostrarAvisoDeConectar, Converter={StaticResource VisivelSe}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="A sua senha fica só com a Twitch" Style="{DynamicResource Rotulo}" FontWeight="SemiBold" />
                        <TextBlock Style="{DynamicResource TextoDoAviso}" Margin="0,4,0,0">
                            <Run Text="Conectar abre a Twitch no seu navegador: entre na sua conta, se precisar, e clique em &quot;Autorizar&quot;. Para tirar o acesso depois, clique em Desconectar ou procure &quot;Olho no Chat&quot; nas Conexões da Twitch." />
                            <LineBreak />
                            <Hyperlink Command="{Binding AbrirConexoesCommand}"><Run Text="Abrir as Conexões da Twitch" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Multiplataforma ligado na aba Chat: o que vem abaixo não vale, mas continua editável (a conta continua conectada) -->
            <Border x:Name="avisoMultiplataforma" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding MultiplataformaNaTela, Converter={StaticResource VisivelSe}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{DynamicResource IconeDoCartao}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                               Text="Escrever no chat e mostrar os resgates de pontos não funcionam enquanto o Chat Multiplataforma estiver ligado (aba Chat), mas dá para deixar as opções prontas. A conta continua conectada, e moderar, o AutoMod e o aviso de anúncios continuam funcionando." />
                </Grid>
            </Border>

            <StackPanel x:Name="recursosDaTwitch">
                <TextBlock Text="Escrever no chat" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <!-- A caixa da Twitch só existe no Chat oficial da Twitch (a dica diz) -->
                    <Grid x:Name="linhaCaixaDeDigitar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BD;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Caixa de digitar" Style="{DynamicResource Rotulo}" />
                            <TextBlock x:Name="dicaCaixaDeDigitar" Text="{Binding DicaDaCaixa}" Style="{DynamicResource Dica}" />
                            <TextBlock x:Name="avisoCaixaSoNoChatOficial" Style="{DynamicResource Dica}" Margin="0,6,0,0"
                                       Text="A caixa da Twitch só funciona com o tipo de chat &quot;Chat oficial da Twitch&quot; (aba Chat)."
                                       Visibility="{Binding ComChatOficial, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" />
                        </StackPanel>
                        <ComboBox x:Name="listaCaixaDeDigitar" Grid.Column="2" Style="{DynamicResource ListaDaLinha}"
                                  AutomationProperties.Name="Caixa de digitar" SelectedIndex="{Binding CaixaDeDigitar}">
                            <ComboBoxItem Content="Do Olho no Chat" />
                            <ComboBoxItem Content="Da Twitch (Chat oficial)" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource Cartao}">
                    <!-- Vale só com um atalho salvo para "Escrever no chat da Twitch" (a dica diz onde escolher um) -->
                    <Grid x:Name="linhaFecharDepoisDeEnviar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE724;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Fechar a caixa depois de enviar" Style="{DynamicResource Rotulo}" />
                            <TextBlock x:Name="dicaFecharDepoisDeEnviar" Text="{Binding DicaDeFecharDepoisDeEnviar}" Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorFecharDepoisDeEnviar" Grid.Column="2" IsChecked="{Binding FecharCaixaDepoisDeEnviar}"
                                         AutomationProperties.Name="Fechar a caixa depois de enviar" />
                    </Grid>
                </Border>

                <TextBlock Text="Resgates de pontos do canal" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE734;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Mostrar os resgates no chat" Style="{DynamicResource Rotulo}" />
                            <TextBlock Style="{DynamicResource Dica}"
                                       Text="Só os do seu canal (o da conta conectada), com ele aberto no tipo de chat Padrão. Pontos do canal só existem em canais de afiliados e parceiros." />
                            <!-- Quando a Twitch recusa (por exemplo, canal sem pontos de canal) -->
                            <TextBlock x:Name="problemaDosResgates" Text="{Binding ProblemaDosResgates}" Style="{DynamicResource Erro}" Margin="0,6,0,0"
                                       Visibility="{Binding ProblemaDosResgates, Converter={StaticResource VisivelSe}}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorResgates" Grid.Column="2" IsChecked="{Binding MostrarResgates}"
                                         AutomationProperties.Name="Mostrar os resgates no chat" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Fora de recursosDaTwitch: vale no Chat Multiplataforma (só nas mensagens da Twitch) -->
            <TextBlock Text="Moderação" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE74D;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Moderar no chat" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaModeracao" Text="{Binding DicaDaModeracao, Mode=OneWay}" Style="{DynamicResource Dica}" />
                        <TextBlock x:Name="problemaDaModeracao" Text="{Binding ProblemaDaModeracao}" Style="{DynamicResource Erro}" Margin="0,6,0,0"
                                   Visibility="{Binding ProblemaDaModeracao, Converter={StaticResource VisivelSe}}" />
                        <TextBlock x:Name="situacaoDaModeracao" Text="{Binding SituacaoDaModeracao}" Style="{DynamicResource Dica}" Margin="0,6,0,0"
                                   Visibility="{Binding SituacaoDaModeracao, Converter={StaticResource VisivelSe}}" />
                    </StackPanel>
                    <ctl:Interruptor x:Name="interruptorModeracao" Grid.Column="2" IsChecked="{Binding ModerarNoChat}"
                                     AutomationProperties.Name="Moderar no chat" />
                </Grid>
            </Border>

            <TextBlock Text="Mensagens barradas pelo AutoMod" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE83D;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Aprovar ou recusar no chat" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaAutoMod" Text="{Binding DicaDoAutoMod}" Style="{DynamicResource Dica}" />
                        <TextBlock x:Name="problemaDoAutoMod" Text="{Binding ProblemaDoAutoMod}" Style="{DynamicResource Erro}" Margin="0,6,0,0"
                                   Visibility="{Binding ProblemaDoAutoMod, Converter={StaticResource VisivelSe}}" />
                        <!-- Se a Twitch aceitou no canal aberto agora (ou por que não): laranja só quando é um problema -->
                        <TextBlock x:Name="situacaoDoAutoMod" Text="{Binding SituacaoDoAutoMod}" Margin="0,6,0,0"
                                   Visibility="{Binding SituacaoDoAutoMod, Converter={StaticResource VisivelSe}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dica}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoModComProblema}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource LaranjaClaro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ctl:Interruptor x:Name="interruptorAutoMod" Grid.Column="2" IsChecked="{Binding AprovarAutoMod}"
                                     AutomationProperties.Name="Aprovar ou recusar no chat" />
                </Grid>
            </Border>

            <!-- Também fora de recursosDaTwitch: vale no Chat Multiplataforma (os anúncios são da Twitch) -->
            <TextBlock Text="Anúncios do seu canal" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7F4;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Avisar dos anúncios no chat" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaAnuncios" Text="{Binding DicaDosAnuncios}" Style="{DynamicResource Dica}" />
                        <TextBlock x:Name="problemaDosAnuncios" Text="{Binding ProblemaDosAnuncios}" Style="{DynamicResource Erro}" Margin="0,6,0,0"
                                   Visibility="{Binding ProblemaDosAnuncios, Converter={StaticResource VisivelSe}}" />
                        <!-- Se a Twitch está mostrando os anúncios agora (ou por que não): laranja só quando é um problema -->
                        <TextBlock x:Name="situacaoDosAnuncios" Text="{Binding SituacaoDosAnuncios}" Margin="0,6,0,0"
                                   Visibility="{Binding SituacaoDosAnuncios, Converter={StaticResource VisivelSe}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dica}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnunciosComProblema}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource LaranjaClaro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ctl:Interruptor x:Name="interruptorAnuncios" Grid.Column="2" IsChecked="{Binding AvisarAnuncios}"
                                     AutomationProperties.Name="Avisar dos anúncios no chat" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
