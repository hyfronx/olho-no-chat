<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaGeral"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             xmlns:atalhos="clr-namespace:OlhoNoChat.Atalhos">
    <!-- DataContext = LogicaGeral. Os estilos com nome vêm da janela (DynamicResource). Os cartões que abrem e fecham
         começam fechados toda vez que a janela abre. -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
        <!-- O nome de um grupo de atalhos dentro do cartão (Janela, Chat, AutoMod) -->
        <Style x:Key="GrupoDeAtalhos" TargetType="TextBlock" BasedOn="{StaticResource TituloDaSecao}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
        <Style x:Key="LinhaDoAtalho" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <!-- "Mudar atalho" de uma linha (Tag = a caixa da linha): diz "Confirmar" enquanto a caixa grava. O nome volta
             sozinho também quando o Esc para a gravação. -->
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Geral" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="A janela do chat, os atalhos de teclado e as atualizações." Style="{DynamicResource SubtituloDaPagina}" />

            <TextBlock Text="Janela do chat" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xED1A;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Esconder as bordas ao abrir o app" Style="{DynamicResource Rotulo}" />
                        <TextBlock Text="O chat abre sem a barra laranja, só com as mensagens, e os cliques passam direto para o jogo." Style="{DynamicResource Dica}" />
                    </StackPanel>
                    <ctl:Interruptor x:Name="interruptorEsconderBordas" Grid.Column="2" IsChecked="{Binding EsconderBordasAoAbrir}"
                                     AutomationProperties.Name="Esconder as bordas ao abrir o app" />
                </Grid>
            </Border>
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE75B;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock Text="Esconder o ícone da barra de tarefas" Style="{DynamicResource Rotulo}" />
                        <TextBlock Text="Com as bordas escondidas, o app some da barra de tarefas. O menu fica no ícone do olho, perto do relógio do Windows (clique com o botão direito)." Style="{DynamicResource Dica}" />
                    </StackPanel>
                    <ctl:Interruptor x:Name="interruptorEsconderIcone" Grid.Column="2" IsChecked="{Binding EsconderIconeDaBarraDeTarefas}"
                                     AutomationProperties.Name="Esconder o ícone da barra de tarefas" />
                </Grid>
            </Border>

            <TextBlock Text="Atalhos de teclado" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}" Padding="0">
                <StackPanel>
                    <ToggleButton x:Name="cabecalhoAtalhos" Style="{DynamicResource CabecalhoQueAbre}" AutomationProperties.Name="Mostrar atalhos de teclado">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE765;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Ver e mudar os atalhos" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Funcionam mesmo com o jogo na frente, mas não com esta janela aberta." Style="{DynamicResource Dica}" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="16,0,16,16" Visibility="{Binding IsChecked, ElementName=cabecalhoAtalhos, Converter={StaticResource VisivelSe}}">
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,0,-16,4" />
                        <TextBlock Style="{DynamicResource Dica}" Margin="0,4,0,0"
                                   Text="Para trocar, clique em &quot;Mudar atalho&quot;, aperte as teclas juntas (como Ctrl + Alt + F9) e clique em &quot;Confirmar&quot; (o Esc cancela a troca). Para ficar sem atalho, clique no × da caixa. Use Ctrl, Alt ou Shift para não atrapalhar outros programas." />

                        <!-- Os atalhos em grupos. Quando um atalho só funciona em alguma situação, ela fica numa dica
                             embaixo do nome dele -->
                        <TextBlock Text="Janela" Style="{StaticResource GrupoDeAtalhos}" />
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Mostrar/esconder as bordas" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoBordas" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoBordas}" />
                            <Button x:Name="botaoMudarAtalhoBordas" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoBordas}" Click="MudarAtalho_Click" />
                        </Grid>
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Modo rolagem (rolar o chat com o mouse)" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Só com as bordas escondidas. Com elas visíveis, o chat já rola com o mouse." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoModoRolagem" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoModoRolagem}" />
                            <Button x:Name="botaoMudarAtalhoModoRolagem" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoModoRolagem}" Click="MudarAtalho_Click" />
                        </Grid>
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Sempre no topo (ligar/desligar)" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoSempreNoTopo" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoSempreNoTopo}" />
                            <Button x:Name="botaoMudarAtalhoSempreNoTopo" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoSempreNoTopo}" Click="MudarAtalho_Click" />
                        </Grid>

                        <TextBlock Text="Chat" Style="{StaticResource GrupoDeAtalhos}" />
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Escrever no chat da Twitch" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Precisa da conta da Twitch conectada (aba Twitch). Não funciona com o Chat Multiplataforma ligado." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoEscrever" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoEscrever}" />
                            <Button x:Name="botaoMudarAtalhoEscrever" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoEscrever}" Click="MudarAtalho_Click" />
                        </Grid>
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Pausar/continuar o chat" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Só no tipo de chat Padrão." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoPausar" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoPausar}" />
                            <Button x:Name="botaoMudarAtalhoPausar" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoPausar}" Click="MudarAtalho_Click" />
                        </Grid>

                        <!-- As duas linhas do AutoMod funcionam na mesma situação: a dica fica uma vez só, embaixo do grupo -->
                        <TextBlock Text="AutoMod" Style="{StaticResource GrupoDeAtalhos}" />
                        <TextBlock Style="{DynamicResource Dica}"
                                   Text="Só no tipo de chat Padrão, com &quot;Aprovar ou recusar no chat&quot; ligado na aba Twitch, no seu canal ou num canal que você modera. Funcionam enquanto uma mensagem barrada espera embaixo do chat." />
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Aprovar a mensagem barrada pelo AutoMod" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoAprovarAutoMod" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoAprovarAutoMod}" />
                            <Button x:Name="botaoMudarAtalhoAprovarAutoMod" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoAprovarAutoMod}" Click="MudarAtalho_Click" />
                        </Grid>
                        <Grid Style="{StaticResource LinhaDoAtalho}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Recusar a mensagem barrada pelo AutoMod" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoRecusarAutoMod" Grid.Column="1" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoRecusarAutoMod}" />
                            <Button x:Name="botaoMudarAtalhoRecusarAutoMod" Grid.Column="2" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoRecusarAutoMod}" Click="MudarAtalho_Click" />
                        </Grid>

                        <!-- O atalho de limpar o overlay só muda na aba Overlay (aqui não tem caixa, para não haver dois lugares) -->
                        <TextBlock Style="{DynamicResource Dica}" Margin="0,18,0,0"
                                   Text="O atalho para limpar o overlay da live fica na aba Overlay." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Atualizações" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE895;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Procurar atualizações ao abrir o app" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Avisa quando tiver uma versão nova." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorProcurarAtualizacoes" Grid.Column="2" IsChecked="{Binding ProcurarAtualizacoes}"
                                         AutomationProperties.Name="Procurar atualizações ao abrir o app" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF196;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Receber versões beta" Style="{DynamicResource Rotulo}" />
                            <TextBlock Style="{DynamicResource Dica}"
                                       Text="Versões de teste, com as novidades antes, mas que podem ter problemas. Desligado, o app volta para a última versão normal na próxima atualização (as configurações continuam)." />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorVersoesBeta" Grid.Column="2" IsChecked="{Binding VersoesBeta}"
                                         AutomationProperties.Name="Receber versões beta" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="textoVersao" Style="{DynamicResource Dica}" Margin="0" FontSize="13" VerticalAlignment="Center">
                            <Run Text="Versão atual:" />
                            <Run Text="{Binding Versao, Mode=OneWay}" Foreground="{DynamicResource Texto}" />
                        </TextBlock>
                        <!-- Enquanto procura (ou baixa): o ícone gira, o texto diz o que está fazendo e o botão não aceita clique -->
                        <Button x:Name="botaoProcurarAgora" Grid.Column="1" MinWidth="130" Command="{Binding ProcurarAgoraCommand}"
                                AutomationProperties.Name="{Binding TextoDoProcurarAgora}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontSize="14" Margin="0,1,8,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Procurando}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="girar">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="girar" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TextoDoProcurarAgora}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Avançado" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}" Padding="0">
                <StackPanel>
                    <ToggleButton x:Name="cabecalhoAvancado" Style="{DynamicResource CabecalhoQueAbre}" AutomationProperties.Name="Mostrar opções avançadas">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9F5;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Mostrar opções avançadas" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Abrir mais de uma cópia do app e restaurar tudo para o padrão." Style="{DynamicResource Dica}" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="16,0,16,14" Visibility="{Binding IsChecked, ElementName=cabecalhoAvancado, Converter={StaticResource VisivelSe}}">
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,0,-16,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}" Margin="36,0,16,0">
                                <TextBlock Text="Permitir abrir mais de uma cópia do app (beta)" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Abrir o app de novo abre outra janela de chat, em vez de trazer a que já está aberta. Os atalhos de teclado ficam só com a primeira." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorVariasCopias" Grid.Column="1" IsChecked="{Binding PermitirVariasCopias}"
                                             AutomationProperties.Name="Permitir abrir mais de uma cópia do app" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,12,-16,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{DynamicResource TextoDaLinha}" Margin="36,0,16,0">
                                <TextBlock Text="Restaurar tudo para o padrão" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Todas as opções voltam como na primeira instalação. Ficam como estão: os canais, a conta da Twitch, a lista de usuários e as pessoas bloqueadas dos filtros, as palavras proibidas e o endereço do overlay."
                                           Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <Button x:Name="botaoRestaurar" Grid.Column="1" Content="Restaurar" MinWidth="130" VerticalAlignment="Center"
                                    AutomationProperties.Name="Restaurar tudo para o padrão" Command="{Binding RestaurarCommand}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
