<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaTikTok"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             Loaded="Pagina_Loaded" Unloaded="Pagina_Unloaded">
    <!-- DataContext = LogicaTikTok. Os estilos com nome vêm da janela (DynamicResource). -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="TikTok" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="Sua conta do TikTok, para o chat do TikTok no Chat Multiplataforma." Style="{DynamicResource SubtituloDaPagina}" />

            <!-- Conta: conectar e desconectar acontecem na hora -->
            <TextBlock Text="Conta (opcional)" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE77B;" Style="{DynamicResource IconeDoCartao}" />
                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                        <TextBlock x:Name="textoConta" Text="{Binding TituloDaConta}" Style="{DynamicResource Rotulo}" />
                        <TextBlock x:Name="dicaConta" Text="{Binding DicaDaConta}" Style="{DynamicResource Dica}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="botaoConectar" Content="Conectar" MinWidth="110" Style="{DynamicResource BotaoPrincipal}"
                                Command="{Binding ConectarCommand}"
                                Visibility="{Binding Conectada, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}" />
                        <Button x:Name="botaoDesconectar" Content="Desconectar" MinWidth="110" Command="{Binding DesconectarCommand}"
                                Visibility="{Binding Conectada, Converter={StaticResource VisivelSe}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- O TikTok recusou a sessão -->
            <Border x:Name="avisoRecusada" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding FoiRecusada, Converter={StaticResource VisivelSe}}">
                <TextBlock Style="{DynamicResource TextoDoAviso}"
                           Text="A conta desconectou: o TikTok não aceita mais a sessão (por exemplo, você saiu da conta ou trocou a senha). Clique em Conectar para entrar de novo." />
            </Border>

            <!-- Acabou de desconectar -->
            <Border x:Name="avisoComoEncerrar" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding MostrarComoEncerrar, Converter={StaticResource VisivelSe}}">
                <TextBlock Style="{DynamicResource TextoDoAviso}"
                           Text="Desconectado: a sessão foi apagada deste computador. Para encerrá-la de vez, saia dela também no app do TikTok, em Configurações e privacidade › Segurança › Gerenciar dispositivos." />
            </Border>

            <!-- Sem o Chat Multiplataforma a conta não é usada -->
            <Border x:Name="avisoMultiplataforma" Style="{DynamicResource CartaoDeAviso}" Margin="0,10,0,0"
                    Visibility="{Binding MostrarAvisoMultiplataforma, Converter={StaticResource VisivelSe}}">
                <TextBlock Style="{DynamicResource TextoDoAviso}"
                           Text="A conta só é usada com o Chat Multiplataforma ligado (aba Chat) e um canal do TikTok na faixa do canal." />
            </Border>

            <!-- Por que conectar -->
            <TextBlock Text="Por que conectar uma conta?" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource CartaoDeAviso}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8BD;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}"
                               Text="O TikTok não mostra as mensagens de algumas pessoas para quem assiste sem conta. Com uma conta conectada, o Olho no Chat lê o chat como alguém logado e mostra essas mensagens também. O app só lê: nunca escreve, segue ou curte nada pela conta." />
                </Grid>
            </Border>

            <!-- Segurança -->
            <TextBlock Text="Segurança" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource CartaoDeAviso}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="A sua senha fica só com o TikTok" Style="{DynamicResource Rotulo}" FontWeight="SemiBold" />
                        <TextBlock Style="{DynamicResource TextoDoAviso}" Margin="0,4,0,0"
                                   Text="O login é feito na página do próprio TikTok, numa janela que só abre o TikTok. O Olho no Chat guarda só a sessão, com várias proteções: cifrada e presa a este computador pelo Windows e pelo chip de segurança (TPM), numa pasta que só o seu usuário abre, enviada só para o TikTok, e com a memória do app fechada para outros programas." />
                        <TextBlock Style="{DynamicResource TextoDoAviso}" Margin="0,8,0,0"
                                   Text="Se preferir, conecte uma conta secundária: qualquer conta do TikTok serve para ler o chat." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
