<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             xmlns:atalhos="clr-namespace:OlhoNoChat.Atalhos"
             xmlns:local="clr-namespace:OlhoNoChat.Janelas.Configuracoes">
    <!-- DataContext = LogicaOverlay. Os estilos com nome vêm da janela (DynamicResource). O endereço, o estado, "Encontrar
         outro endereço", o teste e o limpar valem na hora; o resto, no Salvar. -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
        <DataTemplate x:Key="ModeloDaFonte" DataType="{x:Type local:OpcaoDaLista}">
            <TextBlock Text="{Binding Nome}" FontFamily="{Binding Fonte}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Overlay" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="O chat na tela da live, por uma Fonte de navegador do OBS." Style="{DynamicResource SubtituloDaPagina}" />
            <!-- As partes da aba em abas no topo (pedido do usuário, 2026-11-06); a escolhida mostra o painel dela -->
            <ListBox x:Name="listaDeAbas" Style="{DynamicResource AbasDoTopo}" ItemContainerStyle="{DynamicResource AbaDoTopo}"
                     SelectedIndex="0" SelectionChanged="ListaDeAbas_SelectionChanged" AutomationProperties.Name="Partes do overlay">
                <ListBoxItem Content="Geral" AutomationProperties.Name="Geral do overlay" />
                <ListBoxItem Content="Mensagens" AutomationProperties.Name="Mensagens do overlay" />
                <ListBoxItem Content="Visual" AutomationProperties.Name="Visual do overlay" />
                <ListBoxItem Content="Filtros" AutomationProperties.Name="Filtros do overlay" />
                <ListBoxItem Content="Avisos" AutomationProperties.Name="Avisos do overlay" />
            </ListBox>
            <Grid x:Name="paineisDasAbas">
            <StackPanel x:Name="abaGeral">
                <TextBlock Text="Ligar e colocar no OBS" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7F4;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Overlay para a live" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Na live aparecem só as mensagens do chat. A fila do AutoMod e os avisos do próprio app ficam só na sua janela, e pausar o chat não pausa a live." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorOverlay" Grid.Column="2" IsChecked="{Binding OverlayLigado}"
                                             AutomationProperties.Name="Overlay para a live" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <!-- Como o overlay está, logo embaixo do interruptor -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="textoEstado" Text="{Binding TextoDoEstado}" Style="{DynamicResource Rotulo}" />
                                <!-- Porta ocupada: o app acha outra sozinho -->
                                <Button x:Name="botaoEncontrar" Style="{DynamicResource BotaoPrincipal}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="14,0" Height="32" Content="Encontrar outro endereço" Command="{Binding EncontrarOutroEnderecoCommand}"
                                        Visibility="{Binding TemProblema, Converter={StaticResource VisivelSe}}" />
                                <TextBlock x:Name="textoResultado" Text="{Binding ResultadoDaProcura}" Style="{DynamicResource Dica}" Margin="0,8,0,0"
                                           Visibility="{Binding ResultadoDaProcura, Converter={StaticResource VisivelSe}}" />
                                <TextBlock x:Name="textoPassos" Style="{DynamicResource Dica}" Margin="0,4,0,0"
                                           Visibility="{Binding MostrarPassosDoObs, Converter={StaticResource VisivelSe}}"
                                           Text="1. Clique em Copiar, abaixo.&#10;2. No OBS, clique duas vezes na Fonte de navegador do overlay.&#10;3. No campo URL, apague o endereço antigo, cole o novo e clique em OK." />
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71B;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Endereço para o OBS" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="No OBS, em Fontes, clique em + > Navegador e cole este endereço no campo URL. É só uma vez: o endereço não muda." Style="{DynamicResource Dica}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="caixaEndereco" IsReadOnly="True" Text="{Binding Endereco, Mode=OneWay}"
                                             AutomationProperties.Name="Endereço do overlay" />
                                    <Button x:Name="botaoCopiar" Grid.Column="1" Margin="8,0,0,0" ToolTip="Copiar o endereço"
                                            AutomationProperties.Name="Copiar o endereço" Click="Copiar_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{DynamicResource Icone}" FontSize="12" Foreground="{DynamicResource LaranjaClaro}" />
                                            <TextBlock x:Name="textoCopiar" Text="Copiar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Desligado, a dica diz o que falta para usar -->
                                    <Button x:Name="botaoAbrir" Grid.Column="2" Margin="8,0,0,0"
                                            ToolTip="{Binding FaltaParaUsar, TargetNullValue='Ver no navegador como fica'}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="Abrir no navegador" Click="Abrir_Click" IsEnabled="{Binding Funcionando}">
                                        <TextBlock Text="&#xE8A7;" Style="{DynamicResource Icone}" FontSize="12" Foreground="{DynamicResource LaranjaClaro}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE768;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Testar e limpar" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="As mensagens de teste aparecem só no overlay, para ajustar o tamanho e a posição no OBS. Limpar apaga tudo o que está nele." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <!-- Desligados, a dica diz o que falta para usar -->
                            <Button x:Name="botaoTeste" Grid.Column="2" VerticalAlignment="Center" Content="Mensagens de teste" Command="{Binding MandarTesteCommand}"
                                    IsEnabled="{Binding Funcionando}" ToolTip="{Binding FaltaParaUsar}" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="botaoLimpar" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Limpar" Command="{Binding LimparCommand}"
                                    IsEnabled="{Binding Funcionando}" ToolTip="{Binding FaltaParaUsar}" ToolTipService.ShowOnDisabled="True" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE765;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Atalho para limpar" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Tira tudo do overlay na hora, mesmo com o jogo na frente. Para trocar, clique em &quot;Mudar atalho&quot;, aperte as teclas juntas e clique em &quot;Confirmar&quot; (o Esc cancela a troca). Para ficar sem atalho, clique no × da caixa." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <atalhos:EditorDeAtalho x:Name="atalhoLimpar" Grid.Column="2" Width="200" VerticalAlignment="Center" Atalho="{Binding AtalhoLimpar}" />
                            <Button x:Name="botaoMudarAtalhoLimpar" Grid.Column="3" Style="{DynamicResource BotaoMudarAtalho}"
                                    Tag="{Binding ElementName=atalhoLimpar}" Click="MudarAtalho_Click" />
                        </Grid>
                        <!-- A porta, fechada no fim do cartão (quase ninguém precisa mudar). O cabeçalho vai de borda a borda,
                             como as divisórias, e encosta embaixo do cartão. -->
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,12,-16,0" />
                        <StackPanel Margin="-16,0,-16,-12">
                            <ToggleButton x:Name="cabecalhoPorta" Style="{DynamicResource CabecalhoQueAbre}" AutomationProperties.Name="Porta do endereço">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" Style="{DynamicResource IconeDoCartao}" />
                                    <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                        <TextBlock Text="Porta do endereço" Style="{DynamicResource Rotulo}" />
                                        <TextBlock Text="Normalmente não precisa mudar." Style="{DynamicResource Dica}" />
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding IsChecked, ElementName=cabecalhoPorta, Converter={StaticResource VisivelSe}}">
                                <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,0,-16,8" />
                                <TextBlock Style="{DynamicResource Dica}" Margin="0,0,0,8"
                                           Text="Um número de 1024 a 65535. Ao mudar a porta, o endereço muda e você precisa colar o novo no OBS. Se a porta estiver ocupada, use &quot;Encontrar outro endereço&quot;, que acha uma livre sozinho." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Porta" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="caixaPorta" Width="100" MaxLength="5" AutomationProperties.Name="Porta do endereço do overlay"
                                             Text="{Binding Porta, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="avisoSoNoPadrao" Style="{DynamicResource CartaoDeAviso}" Margin="0,8,0,0"
                        Visibility="{Binding ComPadrao, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}" VerticalAlignment="Center"
                                   Text="O overlay só funciona com o tipo de chat Padrão. Troque na aba Chat." />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel x:Name="abaMensagens" Visibility="Collapsed">
                <TextBlock Text="Mensagens na live" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A1;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Disposição" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Na faixa horizontal, as mensagens passam numa linha só, da direita para a esquerda. Boa para baixo da câmera ou numa cena de &quot;volto já&quot;." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaDisposicao" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Disposição"
                                      ItemsSource="{x:Static local:LogicaOverlay.Disposicoes}" DisplayMemberPath="Nome"
                                      SelectedValuePath="Valor" SelectedValue="{Binding Disposicao}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding EmFaixa}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Velocidade da faixa" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                            <Slider x:Name="deslizanteVelocidadeDaFaixa" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Velocidade da faixa"
                                    Minimum="30" Maximum="400" SmallChange="10" LargeChange="40" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding VelocidadeDaFaixa}" />
                            <TextBlock Grid.Column="2" Width="130" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}"
                                       Text="{Binding TextoDaVelocidadeDaFaixa}" />
                        </Grid>
                        <!-- Na faixa, as opções só da lista ficam escondidas: esta linha diz onde elas aparecem -->
                        <StackPanel Visibility="{Binding EmFaixa, Converter={StaticResource VisivelSe}}">
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <TextBlock x:Name="textoSoNaLista" Style="{DynamicResource Dica}" Margin="36,0,0,0"
                                       Text="Quantas mensagens, sumir, onde entram, alinhamento e animação só aparecem com &quot;Uma embaixo da outra&quot;." />
                        </StackPanel>
                        <!-- As opções que só valem uma embaixo da outra -->
                        <StackPanel x:Name="opcoesDaLista" Visibility="{Binding EmLista, Converter={StaticResource VisivelSe}}">
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8BD;" Style="{DynamicResource IconeDoCartao}" />
                                <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                    <TextBlock Text="Quantas mensagens" Style="{DynamicResource Rotulo}" />
                                    <TextBlock Text="Com &quot;As que couberem&quot;, elas enchem a Fonte de navegador do OBS. Com um número, quando chega uma nova, a mais antiga sai." Style="{DynamicResource Dica}" />
                                </StackPanel>
                                <ComboBox x:Name="listaQuantas" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Quantas mensagens"
                                          ItemsSource="{x:Static local:LogicaOverlay.Quantidades}" DisplayMemberPath="Nome"
                                          SelectedValuePath="Valor" SelectedValue="{Binding Quantidade}" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding ComLimiteDeMensagens}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="No máximo" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                                <Slider x:Name="deslizanteMensagens" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Mensagens no máximo"
                                        Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Mensagens}" />
                                <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDasMensagens}" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" Style="{DynamicResource IconeDoCartao}" />
                                <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                    <TextBlock Text="As mensagens somem" Style="{DynamicResource Rotulo}" />
                                    <TextBlock Text="Cada mensagem sai da tela depois do tempo escolhido abaixo. Desligado, elas só saem quando chegam novas." Style="{DynamicResource Dica}" />
                                </StackPanel>
                                <ctl:Interruptor x:Name="interruptorSome" Grid.Column="2" IsChecked="{Binding OverlaySome}"
                                                 AutomationProperties.Name="As mensagens somem" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding SomemNaLista}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Somem depois de" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                                <Slider x:Name="deslizanteSumir" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Somem depois de"
                                        Minimum="5" Maximum="300" SmallChange="5" LargeChange="15" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding SegundosParaSumir}" />
                                <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoSumir}" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8CB;" Style="{DynamicResource IconeDoCartao}" />
                                <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                    <TextBlock Text="Onde entram as novas" Style="{DynamicResource Rotulo}" />
                                </StackPanel>
                                <ComboBox x:Name="listaDirecao" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Onde entram as novas"
                                          ItemsSource="{x:Static local:LogicaOverlay.Direcoes}" DisplayMemberPath="Nome"
                                          SelectedValuePath="Valor" SelectedValue="{Binding Direcao}" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8E4;" Style="{DynamicResource IconeDoCartao}" />
                                <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                    <TextBlock Text="Alinhamento" Style="{DynamicResource Rotulo}" />
                                    <TextBlock Text="Use à direita quando o chat fica no canto direito da live." Style="{DynamicResource Dica}" />
                                </StackPanel>
                                <ComboBox x:Name="listaAlinhamento" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Alinhamento"
                                          ItemsSource="{x:Static local:LogicaOverlay.Alinhamentos}" DisplayMemberPath="Nome"
                                          SelectedValuePath="Valor" SelectedValue="{Binding Alinhamento}" />
                            </Grid>
                            <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE945;" Style="{DynamicResource IconeDoCartao}" />
                                <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                    <TextBlock Text="Animação" Style="{DynamicResource Rotulo}" />
                                    <TextBlock Text="Como cada mensagem entra e sai da tela." Style="{DynamicResource Dica}" />
                                </StackPanel>
                                <ComboBox x:Name="listaAnimacao" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Animação"
                                          ItemsSource="{x:Static local:LogicaOverlay.Animacoes}" DisplayMemberPath="Nome"
                                          SelectedValuePath="Valor" SelectedValue="{Binding Animacao}" />
                            </Grid>
                        </StackPanel>
                        <!-- O atraso vale para as duas disposições -->
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Atraso" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Cada mensagem espera esse tempo antes de aparecer na live. Se ela for apagada (ou a pessoa levar timeout ou ban) antes disso, nem aparece." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <Slider x:Name="deslizanteAtraso" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Atraso"
                                    Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SegundosDeAtraso}" />
                            <TextBlock Grid.Column="3" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoAtraso}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            <StackPanel x:Name="abaVisual" Visibility="Collapsed">
                <TextBlock Text="Visual" Style="{DynamicResource TituloDaSecao}" />
                <Border Style="{DynamicResource Cartao}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8E8;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Tamanho do texto" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <Slider x:Name="deslizanteTamanho" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Tamanho do texto"
                                    Minimum="10" Maximum="60" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding TamanhoDoTexto}" />
                            <TextBlock Grid.Column="3" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoTamanho}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D2;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Fonte" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <ComboBox x:Name="listaFonte" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Fonte"
                                      ItemsSource="{x:Static local:LogicaOverlay.Fontes}" ItemTemplate="{StaticResource ModeloDaFonte}"
                                      SelectedValuePath="Valor" SelectedValue="{Binding Fonte}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8DD;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Letras em negrito" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorNegrito" Grid.Column="2" IsChecked="{Binding Negrito}" AutomationProperties.Name="Letras em negrito" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8E9;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Contorno das letras" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Ajuda a ler as mensagens em cima de partes claras da live." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaContorno" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Contorno das letras"
                                      ItemsSource="{x:Static local:LogicaOverlay.Contornos}" DisplayMemberPath="Nome"
                                      SelectedValuePath="Valor" SelectedValue="{Binding Contorno}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE771;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Estilo das mensagens" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Cartão escuro: um fundo atrás de cada mensagem. Balão: o mesmo fundo, arredondado, com o nome em cima." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ComboBox x:Name="listaFundo" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Estilo das mensagens"
                                      ItemsSource="{x:Static local:LogicaOverlay.Fundos}" DisplayMemberPath="Nome"
                                      SelectedValuePath="Valor" SelectedValue="{Binding Fundo}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding ComCartao}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Escuro do fundo" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                            <Slider x:Name="deslizanteOpacidade" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Escuro do fundo"
                                    Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding OpacidadeDoFundo}" />
                            <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDaOpacidade}" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8EC;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Selos" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Moderador, VIP, inscrito e outros, antes do nome." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorSelos" Grid.Column="2" IsChecked="{Binding Selos}" AutomationProperties.Name="Selos" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE121;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Horário das mensagens" Style="{DynamicResource Rotulo}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorHorario" Grid.Column="2" IsChecked="{Binding Horario}" AutomationProperties.Name="Horário das mensagens" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8E1;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Selo de primeira vez" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Mostra &quot;Primeira vez&quot; na live antes do nome de quem fala no seu canal pela primeira vez. Só na Twitch." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorPrimeiraVez" Grid.Column="2" IsChecked="{Binding PrimeiraVez}" AutomationProperties.Name="Selo de primeira vez na live" />
                        </Grid>
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                        <Grid Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Ícone da plataforma" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Twitch, YouTube, Kick ou TikTok, antes do nome. Só com o Chat Multiplataforma ligado (aba Chat)." Style="{DynamicResource Dica}" />
                            </StackPanel>
                            <ctl:Interruptor x:Name="interruptorPlataforma" Grid.Column="2" IsChecked="{Binding Plataforma}" AutomationProperties.Name="Ícone da plataforma" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            <StackPanel x:Name="abaFiltros" Visibility="Collapsed">
