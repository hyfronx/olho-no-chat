<UserControl x:Class="OlhoNoChat.Janelas.Configuracoes.PaginaOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OlhoNoChat.Controles"
             xmlns:atalhos="clr-namespace:OlhoNoChat.Atalhos"
             xmlns:local="clr-namespace:OlhoNoChat.Janelas.Configuracoes">
    <!-- DataContext = LogicaOverlay. Os estilos com nome vêm da janela (DynamicResource). O endereço, o estado, "Encontrar
         outro endereço", o teste e o limpar valem na hora; o resto, no Salvar. -->
    <UserControl.Resources>
        <ctl:VisivelSe x:Key="VisivelSe" />
        <DataTemplate x:Key="ModeloDaFonte" DataType="{x:Type local:OpcaoDaLista}">
            <TextBlock Text="{Binding Nome}" FontFamily="{Binding Fonte}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PaginaComRolagem}">
        <StackPanel Style="{DynamicResource PainelDaPagina}">
            <TextBlock Text="Overlay" Style="{DynamicResource TituloDaPagina}" />
            <TextBlock Text="O chat na tela da live: uma Fonte de navegador do OBS que mostra só as mensagens." Style="{DynamicResource SubtituloDaPagina}" />

            <TextBlock Text="Overlay da live" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Overlay para a live" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Só as mensagens do chat vão para a live: o AutoMod, a pausa e os avisos do app ficam só na sua janela." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorOverlay" Grid.Column="2" IsChecked="{Binding OverlayLigado}"
                                         AutomationProperties.Name="Overlay para a live" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE71B;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Endereço para o OBS" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="No OBS: Fontes > + > Navegador, e cole no campo URL. Coloque uma vez: o endereço não muda." Style="{DynamicResource Dica}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="caixaEndereco" IsReadOnly="True" Text="{Binding Endereco, Mode=OneWay}"
                                         AutomationProperties.Name="Endereço do overlay" />
                                <Button x:Name="botaoCopiar" Grid.Column="1" Margin="8,0,0,0" ToolTip="Copiar o endereço"
                                        AutomationProperties.Name="Copiar o endereço" Click="Copiar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{DynamicResource Icone}" FontSize="12" Foreground="{DynamicResource LaranjaClaro}" />
                                        <TextBlock x:Name="textoCopiar" Text="Copiar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="botaoAbrir" Grid.Column="2" Margin="8,0,0,0" ToolTip="Abrir no navegador para ver como fica"
                                        AutomationProperties.Name="Abrir no navegador" Click="Abrir_Click" IsEnabled="{Binding Funcionando}">
                                    <TextBlock Text="&#xE8A7;" Style="{DynamicResource Icone}" FontSize="12" Foreground="{DynamicResource LaranjaClaro}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="textoEstado" Text="{Binding TextoDoEstado}" Style="{DynamicResource Rotulo}" />
                            <!-- Porta ocupada: o app acha outra sozinho -->
                            <Button x:Name="botaoEncontrar" Style="{DynamicResource BotaoPrincipal}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Padding="14,0" Height="32" Content="Encontrar outro endereço" Command="{Binding EncontrarOutroEnderecoCommand}"
                                    Visibility="{Binding TemProblema, Converter={StaticResource VisivelSe}}" />
                            <TextBlock x:Name="textoResultado" Text="{Binding ResultadoDaProcura}" Style="{DynamicResource Dica}" Margin="0,8,0,0"
                                       Visibility="{Binding ResultadoDaProcura, Converter={StaticResource VisivelSe}}" />
                            <TextBlock x:Name="textoPassos" Style="{DynamicResource Dica}" Margin="0,4,0,0"
                                       Visibility="{Binding MostrarPassosDoObs, Converter={StaticResource VisivelSe}}"
                                       Text="1. Clique em Copiar, acima.&#10;2. No OBS, clique duas vezes na fonte do overlay.&#10;3. Cole no campo URL e clique em OK." />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE768;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Testar e limpar" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Mensagens de exemplo para montar o layout no OBS. Limpar tira tudo do overlay na hora (também pelo atalho, abaixo)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <Button x:Name="botaoTeste" Grid.Column="2" VerticalAlignment="Center" Content="Mensagens de teste" Command="{Binding MandarTesteCommand}"
                                IsEnabled="{Binding Funcionando}" />
                        <Button x:Name="botaoLimpar" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Limpar" Command="{Binding LimparCommand}"
                                IsEnabled="{Binding Funcionando}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE765;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Atalho para limpar" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Funciona com o jogo em primeiro plano. Para apagar, clique em &quot;Mudar atalho&quot; e aperte Esc." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <atalhos:EditorDeAtalho x:Name="atalhoLimpar" Grid.Column="2" Width="170" VerticalAlignment="Center" Atalho="{Binding AtalhoLimpar}" />
                        <Button x:Name="botaoMudarAtalhoLimpar" Grid.Column="3" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Center"
                                Content="Mudar atalho" Tag="{Binding ElementName=atalhoLimpar}" Click="MudarAtalho_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="avisoSoNoPadrao" Style="{DynamicResource CartaoDeAviso}" Margin="0,8,0,0"
                    Visibility="{Binding ComPadrao, Converter={StaticResource VisivelSe}, ConverterParameter=Nao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{DynamicResource IconeDoCartao}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource TextoDoAviso}" VerticalAlignment="Center"
                               Text="O overlay só recebe mensagens com o tipo de chat Padrão (aba Chat)." />
                </Grid>
            </Border>

            <TextBlock Text="Mensagens na live" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE916;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="As mensagens somem" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Cada mensagem aparece e some depois de um tempo, em vez de ficar parada na tela." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorSome" Grid.Column="2" IsChecked="{Binding OverlaySome}"
                                         AutomationProperties.Name="As mensagens somem" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding OverlaySome}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Somem depois de" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                        <Slider x:Name="deslizanteSumir" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Somem depois de"
                                Minimum="5" Maximum="300" SmallChange="5" LargeChange="15" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding SegundosParaSumir}" />
                        <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoSumir}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE823;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Atraso" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="As mensagens esperam antes de ir para a live. Dá tempo de apagar uma mensagem ruim antes de ela aparecer." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <Slider x:Name="deslizanteAtraso" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Atraso"
                                Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding SegundosDeAtraso}" />
                        <TextBlock Grid.Column="3" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoAtraso}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BD;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Mensagens na tela" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="No máximo; as mais antigas saem quando chegam novas." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <Slider x:Name="deslizanteMensagens" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Mensagens na tela"
                                Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Mensagens}" />
                        <TextBlock Grid.Column="3" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDasMensagens}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8CB;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Onde entram as novas" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ComboBox x:Name="listaDirecao" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Onde entram as novas"
                                  ItemsSource="{x:Static local:LogicaOverlay.Direcoes}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Direcao}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8E4;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Alinhamento" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="À direita, para o chat no canto direito da tela." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ComboBox x:Name="listaAlinhamento" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Alinhamento"
                                  ItemsSource="{x:Static local:LogicaOverlay.Alinhamentos}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Alinhamento}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE945;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Animação" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Como cada mensagem entra (e sai, quando some)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ComboBox x:Name="listaAnimacao" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Animação"
                                  ItemsSource="{x:Static local:LogicaOverlay.Animacoes}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Animacao}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Visual" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8E8;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Tamanho do texto" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <Slider x:Name="deslizanteTamanho" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Tamanho do texto"
                                Minimum="10" Maximum="60" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding TamanhoDoTexto}" />
                        <TextBlock Grid.Column="3" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDoTamanho}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8D2;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Fonte" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ComboBox x:Name="listaFonte" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Fonte"
                                  ItemsSource="{x:Static local:LogicaOverlay.Fontes}" ItemTemplate="{StaticResource ModeloDaFonte}"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Fonte}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8DD;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Letras em negrito" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorNegrito" Grid.Column="2" IsChecked="{Binding Negrito}" AutomationProperties.Name="Letras em negrito" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8E9;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Contorno das letras" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Na live o fundo muda o tempo todo: o contorno ajuda a ler em cima de partes claras." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ComboBox x:Name="listaContorno" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Contorno das letras"
                                  ItemsSource="{x:Static local:LogicaOverlay.Contornos}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Contorno}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE771;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Fundo das mensagens" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ComboBox x:Name="listaFundo" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Fundo das mensagens"
                                  ItemsSource="{x:Static local:LogicaOverlay.Fundos}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Fundo}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding ComCartao}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Escuro do cartão" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                        <Slider x:Name="deslizanteOpacidade" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Escuro do cartão"
                                Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding OpacidadeDoFundo}" />
                        <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDaOpacidade}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8EC;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Selos" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Os de moderador, VIP, inscrito e outros, antes do nome." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorSelos" Grid.Column="2" IsChecked="{Binding Selos}" AutomationProperties.Name="Selos" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE121;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Horário das mensagens" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorHorario" Grid.Column="2" IsChecked="{Binding Horario}" AutomationProperties.Name="Horário das mensagens" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE774;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Ícone da plataforma" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Twitch, YouTube, Kick ou TikTok antes do nome. Vale com o Chat Multiplataforma ligado." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorPlataforma" Grid.Column="2" IsChecked="{Binding Plataforma}" AutomationProperties.Name="Ícone da plataforma" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Filtros só da live" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Dica}" Margin="0,0,0,10"
                               Text="Valem só para o overlay: o seu chat continua mostrando tudo. Os filtros do chat (aba Chat) valem para os dois." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE756;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Esconder comandos" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="As mensagens que começam com o prefixo dos comandos (como !discord)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorComandos" Grid.Column="2" IsChecked="{Binding EsconderComandos}" AutomationProperties.Name="Esconder comandos" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <StackPanel Orientation="Horizontal" Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding EsconderComandos}">
                        <TextBlock Text="Prefixo" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="caixaPrefixo" Width="80" MaxLength="5" AutomationProperties.Name="Prefixo dos comandos"
                                 Text="{Binding PrefixoDosComandos, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE99A;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Esconder bots" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Nightbot, StreamElements e outros bots conhecidos (e nomes que terminam em bot)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorBots" Grid.Column="2" IsChecked="{Binding EsconderBots}" AutomationProperties.Name="Esconder bots" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE71B;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Links" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Evita divulgação e golpe na tela da live." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ComboBox x:Name="listaLinks" Grid.Column="2" Style="{DynamicResource ListaDaLinha}" AutomationProperties.Name="Links"
                                  ItemsSource="{x:Static local:LogicaOverlay.OpcoesDeLinks}" DisplayMemberPath="Nome"
                                  SelectedValuePath="Valor" SelectedValue="{Binding Links}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{DynamicResource IconeDoCartao}" VerticalAlignment="Top" Margin="2,2,16,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Palavras proibidas" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Uma por linha. Na live, cada uma vira ****. Um * no fim pega o começo da palavra: idiot* pega idiota e idiotas." Style="{DynamicResource Dica}" />
                            <TextBox x:Name="caixaPalavras" Style="{DynamicResource CaixaDeVariasLinhas}" Height="90" Margin="0,8,0,0"
                                     AutomationProperties.Name="Palavras proibidas"
                                     Text="{Binding PalavrasProibidas, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8C6;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Cortar mensagens longas" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="O resto vira &#8230; e a mensagem não tampa o jogo." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorTamanho" Grid.Column="2" IsChecked="{Binding LimitarTamanho}" AutomationProperties.Name="Cortar mensagens longas" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding LimitarTamanho}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="No máximo" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                        <Slider x:Name="deslizanteCaracteres" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Letras no máximo"
                                Minimum="20" Maximum="500" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Caracteres}" />
                        <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDosCaracteres}" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE76E;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Limitar emotes por mensagem" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Contra o spam de emotes (os que passam do limite não aparecem)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorEmotes" Grid.Column="2" IsChecked="{Binding LimitarEmotes}" AutomationProperties.Name="Limitar emotes por mensagem" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding LimitarEmotes}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="No máximo" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" />
                        <Slider x:Name="deslizanteEmotes" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Emotes no máximo"
                                Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Emotes}" />
                        <TextBlock Grid.Column="2" Width="96" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" Style="{DynamicResource Rotulo}" Text="{Binding TextoDosEmotes}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Avisos na live" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE789;" Style="{DynamicResource IconeDoCartao}" />
                        <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Quais avisos vão para a live" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Só os que o seu chat também mostra (os interruptores de &quot;Avisos no chat&quot;, na aba Chat)." Style="{DynamicResource Dica}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Inscrições da Twitch" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Inscrições, renovações e presentes de inscrição." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorInscricoes" Grid.Column="1" IsChecked="{Binding Inscricoes}" AutomationProperties.Name="Inscrições da Twitch" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Raids da Twitch" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorRaids" Grid.Column="1" IsChecked="{Binding Raids}" AutomationProperties.Name="Raids da Twitch" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Outros avisos da Twitch" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Comunicados, sequências de visualizações e selos de Bits." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorOutrosDaTwitch" Grid.Column="1" IsChecked="{Binding OutrosAvisosDaTwitch}" AutomationProperties.Name="Outros avisos da Twitch" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Resgates de pontos do canal" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorResgates" Grid.Column="1" IsChecked="{Binding Resgates}" AutomationProperties.Name="Resgates de pontos do canal" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Super Chats do YouTube" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorSuperChats" Grid.Column="1" IsChecked="{Binding SuperChats}" AutomationProperties.Name="Super Chats do YouTube" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Membros do YouTube" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorMembros" Grid.Column="1" IsChecked="{Binding MembrosDoYouTube}" AutomationProperties.Name="Membros do YouTube" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Presentes do TikTok" Style="{DynamicResource Rotulo}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorPresentes" Grid.Column="1" IsChecked="{Binding PresentesDoTikTok}" AutomationProperties.Name="Presentes do TikTok" />
                    </Grid>
                    <Rectangle Style="{DynamicResource DivisoriaDoCartao}" />
                    <Grid Margin="36,0,0,0" Style="{DynamicResource LinhaDependente}" IsEnabled="{Binding MultiplataformaNaTela}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{DynamicResource TextoDaLinha}">
                            <TextBlock Text="Outros avisos do TikTok" Style="{DynamicResource Rotulo}" />
                            <TextBlock Text="Novos seguidores, compartilhamentos e Super Fãs." Style="{DynamicResource Dica}" />
                        </StackPanel>
                        <ctl:Interruptor x:Name="interruptorOutrosDoTikTok" Grid.Column="1" IsChecked="{Binding OutrosAvisosDoTikTok}" AutomationProperties.Name="Outros avisos do TikTok" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Avançado" Style="{DynamicResource TituloDaSecao}" />
            <Border Style="{DynamicResource Cartao}" Padding="0">
                <StackPanel>
                    <ToggleButton x:Name="cabecalhoAvancado" Style="{DynamicResource CabecalhoQueAbre}" AutomationProperties.Name="Mostrar as opções avançadas do overlay">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" Style="{DynamicResource IconeDoCartao}" />
                            <StackPanel Grid.Column="1" Style="{DynamicResource TextoDaLinha}">
                                <TextBlock Text="Porta do endereço" Style="{DynamicResource Rotulo}" />
                                <TextBlock Text="Só para quem sabe o que está fazendo." Style="{DynamicResource Dica}" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="16,0,16,16" Visibility="{Binding IsChecked, ElementName=cabecalhoAvancado, Converter={StaticResource VisivelSe}}">
                        <Rectangle Style="{DynamicResource DivisoriaDoCartao}" Margin="-16,0,-16,8" />
                        <TextBlock Style="{DynamicResource Dica}" Margin="0,0,0,8"
                                   Text="Um número de 1024 a 65535. Mudando a porta, o endereço muda e é preciso trocar no OBS. Se a porta estiver ocupada, prefira &quot;Encontrar outro endereço&quot;, que acha uma livre sozinho." />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Porta" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="caixaPorta" Width="100" MaxLength="5" AutomationProperties.Name="Porta do endereço do overlay"
                                     Text="{Binding Porta, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
