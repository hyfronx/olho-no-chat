<Window x:Class="OlhoNoChat.Janelas.NovaVersao.JanelaNovaVersao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nova versão disponível"
        Icon="/icons/olho_no_chat.ico"
        Width="400" Height="255" ResizeMode="NoResize" WindowStyle="ToolWindow" Topmost="True"
        Background="{DynamicResource FundoDoAviso}" Foreground="{DynamicResource Texto}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=botaoAtualizar}">
    <!-- DataContext = LogicaNovaVersao. Sem a barra do Windows: o "×" é o do app, e o alto da janela arrasta. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Tem uma versão nova do Olho no Chat!" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Versão atual:" FontWeight="SemiBold" Margin="0,0,10,0" />
                <TextBlock x:Name="textoVersaoAtual" Grid.Column="1" Text="{Binding VersaoAtual}" />
                <TextBlock Grid.Row="1" Text="Versão nova:" FontWeight="SemiBold" Margin="0,5,10,0" />
                <TextBlock x:Name="textoVersaoNova" Grid.Row="1" Grid.Column="1" Text="{Binding VersaoNova}" Margin="0,5,0,0" />
            </Grid>

            <CheckBox x:Name="caixaNaoProcurar" Content="Não procurar atualizações automaticamente" Margin="0,20,0,0"
                      IsChecked="{Binding NaoProcurarAutomaticamente}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="botaoAtualizar" Content="Atualizar agora" Style="{StaticResource BotaoPrincipal}" MinWidth="110" Margin="0,0,10,0"
                        IsDefault="True" Click="BotaoAtualizar_Click" />
                <Button x:Name="botaoDepois" Content="Depois" MinWidth="100" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <Button x:Name="botaoFecharJanela" Style="{StaticResource BotaoFecharDaBarra}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,6,0" Click="BotaoFecharJanela_Click" />
    </Grid>
</Window>
