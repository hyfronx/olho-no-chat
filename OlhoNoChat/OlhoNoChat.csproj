<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<StartupObject>OlhoNoChat.App</StartupObject>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>olho_no_chat.ico</ApplicationIcon>
		<AssemblyName>OlhoNoChat</AssemblyName>
		<Product>Olho no Chat</Product>
		<AssemblyTitle>Olho no Chat</AssemblyTitle>
		<Description>Mostra o chat da sua live por cima do jogo.</Description>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Single file, but the native DLLs stay next to the exe (no IncludeNativeLibrariesForSelfExtract):
		     the app is installed as a folder anyway, and nothing is extracted to %TEMP% on each new version -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- WebView2Loader.dll already goes next to the exe; skip the package's extra runtimes\win-x64\native copy -->
		<WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>

		<!-- Keep the package small: only Portuguese framework resources, no XML docs from packages -->
		<SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
		<AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- NuGet package dependencies -->
	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="Jot" Version="2.1.17" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
		<PackageReference Include="ModernWpfUI" Version="0.9.6" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NHotkey.Wpf" Version="3.0.0" />
		<PackageReference Include="TwitchLib.EventSub.Core" Version="3.0.0-preview.58.b20c9f1" />
		<PackageReference Include="TwitchLib.EventSub.Websockets" Version="0.7.0-preview.70.cd91499" />
		<PackageReference Include="Velopack" Version="0.0.1298" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="assets\images\olho_no_chat_256.png" />
		<Resource Include="assets\images\olho_no_chat_256.png" />
		<!-- The app icon file (also ApplicationIcon and vpk's icon), used by the windows as /icons/olho_no_chat.ico -->
		<None Remove="olho_no_chat.ico" />
		<Resource Include="olho_no_chat.ico" Link="icons\olho_no_chat.ico" />
	</ItemGroup>

	<!-- content files that need to be copied to the output directory -->
	<ItemGroup>
		<Content Include="assets\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="browser\*.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\LICENSE" Link="LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<ApplicationDefinition Remove="App.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <Page Include="App.xaml" />
	</ItemGroup>

</Project>