<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<StartupObject>OlhoNoChat.Inicio.Programa</StartupObject>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>olho_no_chat.ico</ApplicationIcon>
		<AssemblyName>OlhoNoChat</AssemblyName>
		<Product>Olho no Chat</Product>
		<AssemblyTitle>Olho no Chat</AssemblyTitle>
		<Description>Mostra o chat da sua live por cima do jogo.</Description>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- As chamadas ao Windows usam [LibraryImport], que gera código unsafe -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Single file, but the native DLLs stay next to the exe (no IncludeNativeLibrariesForSelfExtract):
		     the app is installed as a folder anyway, and nothing is extracted to %TEMP% on each new version -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- WebView2Loader.dll already goes next to the exe; skip the package's extra runtimes\win-x64\native copy -->
		<WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>

		<!-- Keep the package small: only Portuguese framework resources, no XML docs from packages -->
		<SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
		<AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- NuGet package dependencies -->
	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
		<PackageReference Include="NAudio" Version="3.1.0" />
		<PackageReference Include="Velopack" Version="1.2.158" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="assets\images\olho_no_chat_256.png" />
		<Resource Include="assets\images\olho_no_chat_256.png" />
		<!-- The app icon file (also ApplicationIcon and vpk's icon), used by the windows as /icons/olho_no_chat.ico -->
		<None Remove="olho_no_chat.ico" />
		<Resource Include="olho_no_chat.ico" Link="icons\olho_no_chat.ico" />
	</ItemGroup>

	<!-- content files that need to be copied to the output directory -->
	<ItemGroup>
		<Content Include="assets\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="browser\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\LICENSE" Link="LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>