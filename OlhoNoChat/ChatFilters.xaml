<Window x:Class="OlhoNoChat.ChatFilters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Style="{DynamicResource SettingsTitleBarStyle}"
        Title="Filtros do chat"
        Icon="/icons/olho_no_chat.ico"
        WindowStyle="ToolWindow"
        Background="{StaticResource SettingsAccentBrush}"
        Height="700" Width="840" MinHeight="460" MinWidth="660"
        Topmost="True" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        FocusManager.FocusedElement="{Binding ElementName=lvFilters}">
    <Window.Resources>
        <!-- Rounder controls than the ModernWpf default, only in this window -->
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

        <!-- Highlight colour lists (filled in the code), with a box under them for "Personalizada…" -->
        <Style x:Key="HighlightColorList" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBox}">
            <Setter Property="Width" Value="170" />
        </Style>
        <Style x:Key="CustomColorBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ui:ControlHelper.PlaceholderText" Value="#RRGGBB" />
            <Setter Property="AutomationProperties.Name" Value="Cor personalizada" />
        </Style>
        <Style x:Key="CustomColorError" TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
            <Setter Property="Text" Value="Use o formato #RRGGBB." />
            <Setter Property="Foreground" Value="{StaticResource SettingsAccentLightBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- One user of a list: name + remove button -->
        <DataTemplate x:Key="UserChip">
            <Border Background="#383838" CornerRadius="15" Padding="12,3,3,3" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="White" />
                    <Button Margin="6,0,0,0" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Tirar da lista"
                            AutomationProperties.Name="{Binding StringFormat='Tirar {0} da lista'}"
                            ui:ControlHelper.CornerRadius="12"
                            Click="RemoveUser_Click">
                        <ui:FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ChipsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Radio options of the "Usuários" page -->
        <Style x:Key="ModeOption" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="listMode" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsAccentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar, with its own close button (see Helpers/AppWindowFrame.cs) -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <ui:FontIcon Glyph="&#xE71C;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
            <TextBlock Text="Filtros do chat" FontSize="15" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center" Margin="12,0,0,1" />
        </StackPanel>

        <Button x:Name="btnWindowClose" Grid.ColumnSpan="2" Style="{StaticResource TitleCloseButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar a janela" Click="CloseButton_Click">
            <ui:FontIcon FontFamily="{StaticResource TitleIconFont}" Glyph="&#xE8BB;" FontSize="11" />
        </Button>

        <!-- Navigation -->
        <ListView Name="lvFilters" Grid.Row="1"
                  Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                  ItemContainerStyle="{StaticResource SettingsNavItem}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  SelectionChanged="lvFilters_SelectionChanged">
            <ListViewItem AutomationProperties.Name="Usuários">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE716;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Usuários" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="Bloqueios">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE8F8;" Style="{StaticResource SettingsNavIcon}" />
                    <TextBlock Text="Bloqueios" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- Page area, with a rounded corner against the orange frame -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SettingsPageBrush}" CornerRadius="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Usuários: highlight the users of the list, or show only them -->
                <ScrollViewer Name="filterUsernamesGrid" Style="{StaticResource SettingsPageScroll}">
                    <StackPanel Style="{StaticResource SettingsPagePanel}">
                        <TextBlock Text="Usuários" Style="{StaticResource SettingsPageTitle}" />
                        <TextBlock Text="Destaque as mensagens de algumas pessoas, ou veja só as mensagens delas." Style="{StaticResource SettingsPageSubtitle}" />

                        <TextBlock Text="O que fazer com a lista" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <RadioButton Name="rbListOff" Style="{StaticResource ModeOption}" Checked="ListMode_Checked"
                                             AutomationProperties.Name="Nada">
                                    <StackPanel>
                                        <TextBlock Text="Nada" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="A lista fica guardada, mas o chat mostra todo mundo do mesmo jeito." Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Name="cbHighlightUsers" Style="{StaticResource ModeOption}" Checked="ListMode_Checked"
                                             AutomationProperties.Name="Destacar as mensagens dessas pessoas">
                                    <StackPanel>
                                        <TextBlock Text="Destacar as mensagens dessas pessoas" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="Todo mundo aparece, e essas pessoas ficam com um fundo colorido." Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Name="cbAllowedUsers" Style="{StaticResource ModeOption}" Checked="ListMode_Checked"
                                             AutomationProperties.Name="Mostrar só as mensagens dessas pessoas">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar só as mensagens dessas pessoas" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Text="As mensagens de quem não está na lista não aparecem." Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                </RadioButton>

                                <StackPanel Name="highlightColorRow">
                                    <Rectangle Style="{StaticResource SettingsCardDivider}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Style="{StaticResource SettingsRowText}">
                                            <TextBlock Text="Cor do destaque" Style="{StaticResource SettingsLabel}" />
                                            <TextBlock Text="O fundo das mensagens das pessoas da lista." Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox Name="colorPicker" Style="{StaticResource HighlightColorList}"
                                                      AutomationProperties.Name="Cor do destaque" />
                                            <TextBox Name="tbCustomColor" Style="{StaticResource CustomColorBox}" ui:TextBoxHelper.IsDeleteButtonVisible="False" />
                                            <TextBlock Name="tbCustomColorError" Style="{StaticResource CustomColorError}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Lista de usuários" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="tbNewAllowedUser" ui:ControlHelper.PlaceholderText="Nome do usuário na Twitch"
                                             AutomationProperties.Name="Nome do usuário para adicionar à lista"
                                             PreviewKeyDown="NewAllowedUser_PreviewKeyDown" />
                                    <Button Name="btnAddUser" Grid.Column="1" Margin="8,0,0,0" MinWidth="110" Click="OnClick_AddAllowedUsername">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Adicionar" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Name="tbAllowedUserError" Visibility="Collapsed" Style="{StaticResource SettingsHint}"
                                           Foreground="{StaticResource SettingsAccentLightBrush}" Margin="2,6,0,0" />
                                <ItemsControl Name="lvAllowedUsernames" Margin="0,12,0,0" Focusable="False"
                                              ItemTemplate="{StaticResource UserChip}" ItemsPanel="{StaticResource ChipsPanel}"
                                              AutomationProperties.Name="Lista de usuários" />
                                <TextBlock Name="tbAllowedEmpty" Text="Ninguém na lista ainda." Style="{StaticResource SettingsHint}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Moderadores e VIPs" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Name="modsVipsCard" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid Name="modsRow" Style="{StaticResource SettingsDependentRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE83D;" Style="{StaticResource SettingsCardIcon}" />
                                    <TextBlock Name="lblAllMods" Grid.Column="1" Text="Destacar todos os moderadores" Style="{StaticResource SettingsLabel}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ComboBox Name="colorPickerMods" Style="{StaticResource HighlightColorList}"
                                                  AutomationProperties.Name="Cor dos moderadores" />
                                        <TextBox Name="tbCustomColorMods" Style="{StaticResource CustomColorBox}" ui:TextBoxHelper.IsDeleteButtonVisible="False" />
                                        <TextBlock Name="tbCustomColorModsError" Style="{StaticResource CustomColorError}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Name="cbAllMods" Grid.Column="3" Style="{StaticResource SettingsToggle}"
                                                     AutomationProperties.Name="Todos os moderadores" />
                                </Grid>
                                <Rectangle Style="{StaticResource SettingsCardDivider}" />
                                <Grid Name="vipsRow" Style="{StaticResource SettingsDependentRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE734;" Style="{StaticResource SettingsCardIcon}" />
                                    <TextBlock Name="lblAllVIPs" Grid.Column="1" Text="Destacar todos os VIPs" Style="{StaticResource SettingsLabel}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ComboBox Name="colorPickerVIPs" Style="{StaticResource HighlightColorList}"
                                                  AutomationProperties.Name="Cor dos VIPs" />
                                        <TextBox Name="tbCustomColorVIPs" Style="{StaticResource CustomColorBox}" ui:TextBoxHelper.IsDeleteButtonVisible="False" />
                                        <TextBlock Name="tbCustomColorVIPsError" Style="{StaticResource CustomColorError}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Name="cbAllVIPs" Grid.Column="3" Style="{StaticResource SettingsToggle}"
                                                     AutomationProperties.Name="Todos os VIPs" />
                                </Grid>
                                <TextBlock Name="tbModsVipsOff" Text="Escolha &quot;Destacar&quot; ou &quot;Mostrar só&quot; acima para usar estas opções."
                                           Style="{StaticResource SettingsHint}" Margin="36,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Background="#2A211D" BorderBrush="#4A3226" Margin="0,14,0,0" MinHeight="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIcon}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsHint}" Margin="0" FontSize="13" Foreground="#E6D6CF"
                                           Text="Com a lista em uso, o som de nova mensagem só toca para as mensagens destacadas (ou para as que aparecem, no &quot;Mostrar só&quot;)." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bloqueios -->
                <ScrollViewer Name="filterBotsGrid" Style="{StaticResource SettingsPageScroll}" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPagePanel}">
                        <TextBlock Text="Bloqueios" Style="{StaticResource SettingsPageTitle}" />
                        <TextBlock Text="As mensagens destas pessoas nunca aparecem no chat." Style="{StaticResource SettingsPageSubtitle}" />

                        <TextBlock Text="Pessoas bloqueadas" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="tbNewBlockedUser" ui:ControlHelper.PlaceholderText="Nome do usuário na Twitch"
                                             AutomationProperties.Name="Nome do usuário para bloquear"
                                             PreviewKeyDown="NewBlockedUser_PreviewKeyDown" />
                                    <Button Name="btnAddBlockedUser" Grid.Column="1" Margin="8,0,0,0" MinWidth="110" Click="OnClick_AddBlockedUsername">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Bloquear" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Name="tbBlockedUserError" Visibility="Collapsed" Style="{StaticResource SettingsHint}"
                                           Foreground="{StaticResource SettingsAccentLightBrush}" Margin="2,6,0,0" />
                                <ItemsControl Name="lvBlockedUsernames" Margin="0,12,0,0" Focusable="False"
                                              ItemTemplate="{StaticResource UserChip}" ItemsPanel="{StaticResource ChipsPanel}"
                                              AutomationProperties.Name="Pessoas bloqueadas" />
                                <TextBlock Name="tbBlockedEmpty" Text="Ninguém bloqueado." Style="{StaticResource SettingsHint}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Background="#2A211D" BorderBrush="#4A3226" Margin="0,14,0,0" MinHeight="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIcon}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsHint}" Margin="0" FontSize="13" Foreground="#E6D6CF"
                                           Text="Para esconder todos os bots e comandos de uma vez, use &quot;Esconder bots e comandos&quot; na aba Chat das configurações." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom bar -->
                <Border Grid.Row="1" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Salvar applies right away and keeps the window open -->
                        <Button Name="OKButton" Content="Salvar" Style="{StaticResource SettingsPrimaryButton}" Margin="0,0,8,0"
                                ToolTip="Salva e aplica no chat na hora"
                                Click="OKButton_Click" IsDefault="True" />
                        <Button Name="CloseButton" Content="Fechar" Style="{StaticResource SettingsSecondaryButton}" Click="CloseButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
